---
// The header, and the command palette it opens (Menu, or Cmd/Ctrl+K): a glass search box over the
// page listing every section, every project and the contact actions, each previewed beside it.
import { Image } from 'astro:assets';
import Poster from './Poster.astro';
import ring from '../assets/brand/ring.webp';
import { nav, site } from '../data/site';
import { posters } from '../data/posters';

type Item = { id: string; group: string; label: string; hint: string; href?: string; action?: string; keywords: string; preview: { kind: 'text' | 'poster'; text?: string; slug?: string } };
const items: Item[] = [
  ...nav.map((n) => ({ id: `s-${n.label}`, group: 'Sections', label: n.label, hint: n.hint, href: n.href, keywords: n.preview, preview: { kind: 'text' as const, text: n.preview } })),
  ...Object.values(posters).map((p) => ({ id: `p-${p.slug}`, group: 'Work', label: p.title, hint: p.kind, href: p.href, keywords: `${p.kind} ${p.caption} ${p.meta.join(' ')}`, preview: { kind: 'poster' as const, slug: p.slug } })),
  { id: 'a-email', group: 'Contact', label: 'Email me', hint: site.email, href: `mailto:${site.email}`, keywords: 'mail contact hire', preview: { kind: 'text', text: site.email } },
  { id: 'a-copy', group: 'Contact', label: 'Copy email address', hint: 'To your clipboard', action: 'copy', keywords: 'clipboard mail', preview: { kind: 'text', text: site.email } },
  { id: 'a-wa', group: 'Contact', label: 'WhatsApp', hint: site.whatsapp.label, href: site.whatsapp.href, keywords: 'chat message phone call', preview: { kind: 'text', text: site.whatsapp.label } },
  { id: 'a-cv', group: 'Contact', label: 'Résumé', hint: 'Opens the PDF', href: site.resume, keywords: 'cv resume pdf hire', preview: { kind: 'text', text: 'Experience, skills and education, as a PDF.' } },
  ...site.socials.map((s) => ({ id: `a-${s.label}`, group: 'Contact', label: s.label, hint: s.href.replace(/^https?:\/\/(www\.)?/, ''), href: s.href, keywords: 'profile social', preview: { kind: 'text' as const, text: s.href.replace(/^https?:\/\/(www\.)?/, '') } })),
];
const groups = [...new Set(items.map((i) => i.group))];
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__name" href="/" aria-label={`${site.name}, home`}>
      <Image class="hdr__mark" src={ring} alt="" width={26} densities={[1, 2]} loading="eager" />{site.name}
    </a>
    <a class="btn hdr__cta" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
    <button class="hdr__menu" type="button" aria-haspopup="dialog" aria-controls="palette" data-cmd-open>
      <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
      <span>Menu</span>
      <kbd class="hdr__kbd" aria-hidden="true" data-kbd>⌘K</kbd>
    </button>
  </div>
</header>

<dialog class="pal" id="palette" aria-label="Go to" data-cmd>
  <div class="pal__box">
    <label class="pal__search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <span class="sr-only">Search sections, work and contact</span>
      <input type="text" placeholder="Jump to a section, a project, or a way to reach me" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="pal-list" aria-autocomplete="list" data-pal-input />
      <kbd>esc</kbd>
    </label>
    <div class="pal__main">
      <ul class="pal__list" id="pal-list" role="listbox" aria-label="Results" data-pal-list>
        {
          groups.map((g) => (
            <li class="pal__group" role="presentation" data-pal-group={g}>
              <span class="pal__gname" aria-hidden="true">{g}</span>
              <ul role="presentation">
                {items
                  .filter((i) => i.group === g)
                  .map((i) => (
                    <li
                      class="pal__item"
                      id={`pal-${i.id}`}
                      role="option"
                      aria-selected="false"
                      data-pal-item
                      data-id={i.id}
                      data-href={i.href}
                      data-action={i.action}
                      data-search={`${i.label} ${i.hint} ${i.keywords} ${g}`.toLowerCase()}
                    >
                      <span class="pal__label">{i.label}</span>
                      <span class="pal__hint">{i.hint}</span>
                      <span class="pal__enter" aria-hidden="true">↵</span>
                    </li>
                  ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="pal__empty" data-pal-empty hidden>Nothing matches. Try “work”, “email” or a project name.</p>
      <aside class="pal__preview" aria-hidden="true">
        {
          items.map((i) => (
            <div class="pal__pv" data-pv-for={i.id}>
              {i.preview.kind === 'poster' ? (
                <Poster poster={posters[i.preview.slug!]} sizes="260px" decorative />
              ) : (
                <div class="pal__card">
                  <span class="pal__card-kicker">{i.group}</span>
                  <span class="pal__card-title display">{i.label}</span>
                  <span class="pal__card-text">{i.preview.text}</span>
                </div>
              )}
            </div>
          ))
        }
      </aside>
    </div>
    <p class="pal__foot" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span></p>
  </div>
</dialog>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 96%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--d-s) var(--ease);
  }
  :global(html.scrolled) .hdr {
    border-bottom-color: var(--line);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4rem;
  }
  .hdr__name {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
    white-space: nowrap;
  }
  /* The mark: the mercury ring. It turns a little when you point at the name. */
  .hdr__name :global(.hdr__mark) {
    width: 26px;
    height: 26px;
    object-fit: contain;
    transition: rotate var(--d-l) var(--ease);
  }
  @media (hover: hover) {
    .hdr__name:hover :global(.hdr__mark) {
      rotate: 90deg;
    }
  }
  .hdr__cta {
    --h: 2.5rem;
  }
  .hdr__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.25rem 0 0.5rem;
    border: 0;
    background: none;
    font-weight: 600;
    cursor: pointer;
  }
  .hdr__burger {
    display: grid;
    gap: 5px;
    width: 22px;
  }
  .hdr__burger i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: translate var(--d-m) var(--ease);
  }
  @media (hover: hover) {
    .hdr__menu:hover .hdr__burger i:first-child {
      translate: 4px 0;
    }
  }
  .hdr__kbd {
    padding: 2px 6px;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--line);
    font: 600 11px/1.4 var(--f-text);
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .hdr__cta {
      --h: 2.25rem;
      padding: 0 1em;
    }
    .hdr__kbd {
      display: none;
    }
  }

  /* The palette: black glass, the same in both palettes. */
  .pal {
    --ink: #ededE7;
    --muted: #8f8f89;
    --line: rgb(237 237 231 / 0.12);
    width: min(56rem, calc(100vw - 2rem));
    max-width: none;
    max-height: none;
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  .pal::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .pal__box {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    max-height: min(36rem, 76vh);
    border-radius: 18px;
    background: rgb(14 14 14 / 0.93);
    backdrop-filter: blur(28px) saturate(1.2);
    -webkit-backdrop-filter: blur(28px) saturate(1.2);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      0 40px 120px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }
  .pal__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .pal__search input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    border: 0;
    background: none;
    color: var(--ink);
    font: 500 1.1rem/1 var(--f-text);
    outline: none;
  }
  /* The open box is the focus indicator for its own field. */
  .pal__search input:focus-visible {
    outline: none;
    box-shadow: none;
  }
  .pal__search:focus-within {
    color: var(--ink);
  }
  .pal__search input::placeholder {
    color: #6f6f6a;
  }
  .pal kbd {
    padding: 1px 6px;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1px var(--line);
    font: 600 11px/1.5 var(--f-text);
    color: var(--muted);
  }
  .pal__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    min-height: 0;
  }
  .pal__list {
    overflow-y: auto;
    padding: 0.5rem;
    overscroll-behavior: contain;
  }
  .pal__gname {
    display: block;
    padding: 0.7rem 0.75rem 0.35rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pal__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    cursor: pointer;
  }
  .pal__label {
    font-weight: 600;
    white-space: nowrap;
  }
  .pal__hint {
    font-size: var(--t-s);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pal__enter {
    opacity: 0;
    color: var(--muted);
  }
  .pal__item[aria-selected='true'] {
    background: rgb(255 255 255 / 0.09);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .pal__item[aria-selected='true'] .pal__enter {
    opacity: 1;
  }
  .pal__empty {
    padding: 2rem 1.25rem;
    color: var(--muted);
  }
  .pal__preview {
    position: relative;
    border-left: 1px solid var(--line);
    padding: 1rem;
  }
  .pal__pv {
    position: absolute;
    inset: 1rem;
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 220ms var(--ease),
      translate 420ms var(--ease);
  }
  .pal__pv.is-on {
    opacity: 1;
    translate: 0 0;
  }
  .pal__pv :global(.poster) {
    max-height: 100%;
  }
  .pal__card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    height: 100%;
    padding: 1.1rem;
    border-radius: 12px;
    background: radial-gradient(120% 90% at 20% 0%, rgb(255 255 255 / 0.08), transparent 60%);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .pal__card-kicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pal__card-title {
    font-size: 2.6rem;
    line-height: 0.9;
  }
  .pal__card-text {
    font-size: var(--t-s);
    color: #c9c9c3;
    overflow-wrap: anywhere;
  }
  .pal__foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.65rem 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .pal__foot span {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }

  /* Open: the box drops in and settles. */
  @keyframes pal-in {
    from {
      opacity: 0;
      transform: translateY(-14px) scale(0.98);
    }
  }
  :global(html.motion) .pal[open] .pal__box {
    animation: pal-in 420ms var(--ease);
  }

  /* Phones: a sheet from the bottom, list only. */
  @media (max-width: 899px) {
    .pal {
      width: 100vw;
      margin: auto 0 0;
    }
    .pal__box {
      max-height: 88svh;
      border-radius: 22px 22px 0 0;
    }
    .pal__main {
      grid-template-columns: 1fr;
    }
    .pal__preview,
    .pal__foot {
      display: none;
    }
    .pal__item {
      min-height: 48px;
      align-items: center;
    }
    @keyframes pal-up {
      from {
        transform: translateY(40%);
        opacity: 0;
      }
    }
    :global(html.motion) .pal[open] .pal__box {
      animation: pal-up 480ms var(--ease);
    }
  }
</style>

<script>
  import { onPage } from '../motion/start';

  onPage(() => {
    const dlg = document.querySelector<HTMLDialogElement>('[data-cmd]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-cmd-open]');
    if (!dlg || !openBtn) return;
    const input = dlg.querySelector<HTMLInputElement>('[data-pal-input]')!;
    const all = [...dlg.querySelectorAll<HTMLElement>('[data-pal-item]')];
    const groups = [...dlg.querySelectorAll<HTMLElement>('[data-pal-group]')];
    const empty = dlg.querySelector<HTMLElement>('[data-pal-empty]')!;
    const pvs = [...dlg.querySelectorAll<HTMLElement>('[data-pv-for]')];
    const kbd = document.querySelector('[data-kbd]');
    if (kbd && !/Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = 'Ctrl K';
    let shown = all;
    let sel = 0;

    const select = (i: number) => {
      sel = Math.max(0, Math.min(shown.length - 1, i));
      all.forEach((el) => el.setAttribute('aria-selected', 'false'));
      const el = shown[sel];
      if (!el) return input.removeAttribute('aria-activedescendant');
      el.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', el.id);
      el.scrollIntoView({ block: 'nearest' });
      let liquid: HTMLElement | null = null;
      pvs.forEach((pv) => {
        const on = pv.dataset.pvFor === el.dataset.id;
        pv.classList.toggle('is-on', on);
        if (on) liquid = pv.querySelector<HTMLElement>('[data-liquid]');
      });
      // A poster preview gets the mercury running through it.
      document.dispatchEvent(new CustomEvent('liquid:prefer', { detail: liquid }));
    };
    const filter = () => {
      const q = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      shown = all.filter((el) => {
        const hit = q.every((w) => el.dataset.search!.includes(w));
        el.hidden = !hit;
        return hit;
      });
      groups.forEach((g) => (g.hidden = !g.querySelector('[data-pal-item]:not([hidden])')));
      empty.hidden = shown.length > 0;
      // Highlight the first result whose own name matches, not one that only mentions it.
      const named = shown.findIndex((el) => q.every((w) => el.querySelector('.pal__label')!.textContent!.toLowerCase().includes(w)));
      select(Math.max(0, named));
    };
    const run = async (el: HTMLElement | undefined) => {
      if (!el) return;
      if (el.dataset.action === 'copy') {
        const label = el.querySelector('.pal__hint')!;
        try {
          await navigator.clipboard.writeText(document.querySelector<HTMLElement>('[data-pv-for="a-copy"] .pal__card-text')!.textContent!);
          label.textContent = 'Copied';
        } catch {
          label.textContent = 'Could not copy: use Email me';
        }
        setTimeout(() => (label.textContent = 'To your clipboard'), 1600);
        return;
      }
      const href = el.dataset.href!;
      close();
      if (href.startsWith('mailto:')) location.href = href;
      else if (/^https?:/.test(href)) window.open(href, '_blank', 'noopener');
      else location.assign(href);
    };
    const open = () => {
      if (dlg.open) return;
      input.value = '';
      filter();
      dlg.showModal();
      document.documentElement.classList.add('menu-open');
      input.focus();
    };
    const close = () => {
      if (dlg.open) dlg.close();
    };
    const onClose = () => {
      document.documentElement.classList.remove('menu-open');
      document.dispatchEvent(new CustomEvent('liquid:prefer', { detail: null }));
      openBtn.focus({ preventScroll: true });
    };
    const onKey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        dlg.open ? close() : open();
      }
    };
    const onInputKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') select(sel + 1);
      else if (e.key === 'ArrowUp') select(sel - 1);
      else if (e.key === 'Home') select(0);
      else if (e.key === 'End') select(shown.length - 1);
      else if (e.key === 'Enter') run(shown[sel]);
      else return;
      e.preventDefault();
    };
    const onList = (e: Event) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-pal-item]');
      if (!el) return;
      if (e.type === 'click') run(el);
      else select(shown.indexOf(el));
    };
    // A click on the backdrop (outside the box) closes.
    const onDlgClick = (e: MouseEvent) => {
      if (e.target === dlg) close();
    };
    openBtn.addEventListener('click', open);
    document.addEventListener('keydown', onKey);
    input.addEventListener('input', filter);
    input.addEventListener('keydown', onInputKey);
    dlg.addEventListener('click', onList);
    dlg.addEventListener('pointermove', onList);
    dlg.addEventListener('click', onDlgClick);
    dlg.addEventListener('close', onClose);
    return () => {
      close();
      openBtn.removeEventListener('click', open);
      document.removeEventListener('keydown', onKey);
      input.removeEventListener('input', filter);
      input.removeEventListener('keydown', onInputKey);
      dlg.removeEventListener('click', onList);
      dlg.removeEventListener('pointermove', onList);
      dlg.removeEventListener('click', onDlgClick);
      dlg.removeEventListener('close', onClose);
    };
  });
</script>
