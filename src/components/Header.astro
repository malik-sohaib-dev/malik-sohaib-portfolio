---
import { Image } from 'astro:assets';
import Poster from './Poster.astro';
import ring from '../assets/brand/ring.webp';
import { nav, site } from '../data/site';
import { posters } from '../data/posters';
const previews = [...new Set(nav.map((n) => n.preview))];
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__name" href="/" aria-label={`${site.name}, home`}>
      <span class="hdr__logo" data-mark><Image class="hdr__mark" src={ring} alt="" width={26} densities={[1, 2]} loading="eager" /></span>{site.name}
    </a>
    <a class="btn hdr__cta" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
    <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
      <span class="sr-only" data-menu-label>Open menu</span>
    </button>
  </div>

  <!-- The index: a black glass panel wipes down, the links rise, a poster previews the hovered link. -->
  <div class="menu" id="menu" hidden data-menu>
    <div class="wrap menu__in">
      <nav class="menu__nav" aria-label="Main">
        <ol class="menu__list">
          {
            nav.map((n, i) => (
              <li style={`--i:${i}`}>
                <a class="menu__link display" href={n.href} data-preview={n.preview}>
                  <span class="menu__mask">
                    <span class="menu__word">{n.label}</span>
                  </span>
                  {'count' in n && <sup class="menu__count num">{n.count}</sup>}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="menu__preview" aria-hidden="true">
        {
          previews.map((slug) => (
            <div class="menu__poster" data-preview-for={slug}>
              <Poster poster={posters[slug]} sizes="(min-width: 900px) 30vw, 0px" decorative />
            </div>
          ))
        }
      </div>
      <div class="menu__foot">
        <button class="menu__copy" type="button" data-copy={site.email}>
          <span data-copy-label>{site.email}</span>
          <span class="menu__copy-hint" aria-hidden="true">Copy</span>
        </button>
        <a class="ul" href={site.whatsapp.href} target="_blank" rel="noopener">WhatsApp</a>
        <a class="ul" href={site.resume} target="_blank" rel="noopener">Résumé</a>
        {site.socials.map((s) => <a class="ul" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 96%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--d-s) var(--ease);
  }
  :global(html.scrolled) .hdr {
    border-bottom-color: var(--line);
  }
  .hdr__in {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4rem;
  }
  .hdr__name {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
    white-space: nowrap;
  }
  /* The mark: the mercury ring. Once the page is idle (and only with motion on) it swaps to a
     48-frame sprite of the ring wobbling in 3D, played by CSS; until then it is the still ring. */
  .hdr__logo {
    display: block;
    flex: none;
    width: 26px;
    height: 26px;
    background: 0 0 / 1248px 26px no-repeat;
  }
  .hdr__name :global(.hdr__mark) {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }
  .hdr__logo.is-spinning {
    background-image: url('/brand/ring-spin.webp');
    animation: ring-wobble 4.8s steps(48) infinite;
  }
  .hdr__logo.is-spinning :global(.hdr__mark) {
    opacity: 0;
  }
  @keyframes ring-wobble {
    to {
      background-position: -1248px 0;
    }
  }
  .hdr__cta {
    --h: 2.5rem;
  }
  /* Narrow phones: the name and Menu need the room; the hero has its own Email button. */
  @media (max-width: 399px) {
    .hdr__cta {
      display: none;
    }
  }
  /* The toggle is the icon alone: a 44px target, its name kept for screen readers. */
  .hdr__menu {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  /* Two bars that cross into an X when open. */
  .hdr__burger {
    display: grid;
    gap: 5px;
    width: 24px;
  }
  .hdr__burger i {
    display: block;
    height: 2px;
    background: currentColor;
    transition:
      translate var(--d-m) var(--ease),
      rotate var(--d-m) var(--ease);
  }
  :global(html.menu-open) .hdr__burger i:first-child {
    translate: 0 3.5px;
    rotate: 45deg;
  }
  :global(html.menu-open) .hdr__burger i:last-child {
    translate: 0 -3.5px;
    rotate: -45deg;
  }
  /* While open, the header sits on the black glass. */
  :global(html.menu-open) .hdr {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    color: #ededE7;
  }
  :global(html.menu-open) .hdr__cta {
    visibility: hidden;
  }
  @media (max-width: 899px) {
    .hdr__cta {
      --h: 2.25rem;
      padding: 0 1em;
    }
  }

  /* Solid black: the page goes away while the index is open. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: 4rem;
    background: #080808;
    color: #ededE7;
    overflow-y: auto;
    overscroll-behavior: contain;
    --ground: #0b0b0b;
    --ink: #ededE7;
    --muted: #8f8f89;
    --line: rgb(237 237 231 / 0.16);
  }
  .menu__in {
    display: grid;
    gap: 2rem;
    min-height: calc(100svh - 4rem);
    padding-block: 1rem 1.5rem;
    grid-template-rows: 1fr auto;
  }
  .menu__list {
    display: grid;
    align-content: center;
  }
  .menu__link {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.15em;
    font-size: clamp(3.25rem, 13vh, 9.5rem);
    line-height: 0.88;
    text-decoration: none;
  }
  /* The mask clips the rise, not the hover slide: room on the right for the word to move into. */
  .menu__mask {
    display: block;
    overflow: clip;
    padding: 0 0.3em 0.04em 0;
    margin-right: -0.3em;
  }
  .menu__word {
    display: block;
    transition: translate var(--d-m) var(--ease);
  }
  .menu__count {
    font-size: 0.28em;
    line-height: 1;
    margin-top: 0.3em;
    top: 0;
  }
  /* Hovered: the word slides right and the others step back. */
  @media (hover: hover) {
    .menu__list:has(.menu__link:hover) .menu__link:not(:hover) {
      opacity: 0.35;
    }
    .menu__link:hover .menu__word {
      translate: 0.12em 0;
    }
  }
  .menu__link {
    transition: opacity var(--d-s) var(--ease);
  }
  .menu__link[aria-current='page'] .menu__word {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.08em;
  }
  .menu__preview {
    display: none;
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-s);
  }
  .menu__foot a {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }
  .menu__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 40px;
    margin-right: auto;
    padding: 0 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: #ededE7;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--d-s) var(--ease),
      color var(--d-s) var(--ease);
  }
  .menu__copy-hint {
    font-size: var(--t-xs);
    opacity: 0.6;
  }
  @media (hover: hover) {
    .menu__copy:hover {
      background: #ededE7;
      color: #0b0b0b;
    }
  }

  @media (min-width: 900px) {
    .menu__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .menu__nav {
      grid-column: 1 / 8;
      align-self: center;
    }
    .menu__preview {
      display: block;
      position: relative;
      grid-column: 9 / -1;
      align-self: center;
      aspect-ratio: 4 / 5;
      max-height: 68svh;
    }
    .menu__poster {
      position: absolute;
      inset: 0;
      opacity: 0;
      translate: 0 3%;
      scale: 0.96;
      transition:
        opacity var(--d-m) var(--ease),
        translate var(--d-m) var(--ease),
        scale var(--d-m) var(--ease);
      pointer-events: none;
    }
    .menu__poster.is-on {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }
    .menu__foot {
      grid-column: 1 / -1;
    }
  }

  /* Open and close: the panel wipes down from the header, the words rise one after another. */
  /* Open: an ellipse wipes down from the header. */
  :global(html.motion) .menu {
    clip-path: ellipse(140% 0% at 50% 0%);
    transition: clip-path 900ms var(--ease);
  }
  :global(html.motion) .menu.is-open {
    clip-path: ellipse(150% 160% at 50% 0%);
  }
  :global(html.motion) .menu .menu__word {
    translate: 0 105%;
    transition: translate 800ms var(--ease) calc(120ms + var(--i) * 55ms);
  }
  :global(html.motion) .menu.is-open .menu__word {
    translate: 0 0;
  }
  :global(html.motion) .menu .menu__foot {
    opacity: 0;
    transition: opacity var(--d-m) var(--ease) 350ms;
  }
  :global(html.motion) .menu.is-open .menu__foot {
    opacity: 1;
  }
  @media (hover: hover) {
    :global(html.motion) .menu.is-open .menu__link:hover .menu__word {
      translate: 0.12em 0;
      transition-delay: 0ms;
    }
  }
</style>
