---
// GitHub-style contribution grid: one row of weeks per year, both accounts merged (counts only).
import { activityData } from '../data/site';

const { from, to, total, days } = activityData;
const start = Date.parse(`${from}T00:00:00Z`);
const dateOf = (i: number) => new Date(start + i * 864e5);
// Levels from the spread of active days: 1 to 2, 3 to 6, 7 to 17, 18 and up.
const level = (c: number) => (c === 0 ? 0 : c <= 2 ? 1 : c <= 6 ? 2 : c <= 17 ? 3 : 4);

const years = new Map<number, { i: number; c: number }[]>();
days.forEach((c, i) => {
  const y = dateOf(i).getUTCFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push({ i, c });
});
const rows = [...years.entries()].map(([y, list]) => ({
  y,
  total: list.reduce((a, d) => a + d.c, 0),
  // Columns are weeks starting on Sunday, as on GitHub: pad the first week.
  pad: dateOf(list[0].i).getUTCDay(),
  list,
}));
// Weeks (Mon to Sun) with any activity, against all weeks in the range.
const weekly = new Map<number, number>();
days.forEach((c, i) => {
  const w = Math.floor((i + ((dateOf(0).getUTCDay() + 6) % 7)) / 7);
  weekly.set(w, (weekly.get(w) ?? 0) + c);
});
const activeWeeks = [...weekly.values()].filter((c) => c > 0).length;
const nf = new Intl.NumberFormat('en-US');
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fromLabel = `${MONTHS[dateOf(0).getUTCMonth()]} ${dateOf(0).getUTCFullYear()}`;
---

<section class="act" data-field="contrast" aria-labelledby="act-title">
  <div class="wrap">
    <div class="act__head">
      <h2 class="act__title display" id="act-title">
        <span class="act__num">{nf.format(total)}</span>
        <span class="act__unit">contributions</span>
      </h2>
      <p class="act__intro">
        On GitHub since {fromLabel}, across my work and personal accounts. Active in {activeWeeks} of {weekly.size} weeks. Most of it is
        in private repositories, so this is the count, not the code.
      </p>
    </div>

    <div class="act__years" data-activity data-from={from}>
      {
        rows.map((r) => (
          <div class="act__year">
            <p class="act__label">
              <span class="num">{r.y}</span>
              <span>{nf.format(r.total)}</span>
            </p>
            <div class="act__grid" aria-hidden="true">
              {Array.from({ length: r.pad }, () => <i class="act__pad" />)}
              {r.list.map((d) => <i data-l={level(d.c)} data-i={d.i} data-c={d.c} />)}
            </div>
          </div>
        ))
      }
      <p class="act__readout" data-act-readout aria-hidden="true"></p>
    </div>

    <div class="act__legend" aria-hidden="true">
      <span>Less</span>
      {[0, 1, 2, 3, 4].map((l) => <i data-l={l} />)}
      <span>More</span>
      <span class="act__to">to {to.slice(8, 10).replace(/^0/, '')} {MONTHS[+to.slice(5, 7) - 1]} {to.slice(0, 4)}</span>
    </div>
  </div>
</section>

<style>
  .act {
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .act__head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .act__title {
    display: grid;
    margin-left: -0.04em;
  }
  .act__num {
    font-size: var(--t-mega);
  }
  .act__unit {
    font-size: var(--t-l);
    line-height: 1;
  }
  .act__intro {
    max-width: 34rem;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .act__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .act__title {
      grid-column: 1 / 8;
    }
    .act__intro {
      grid-column: 8 / -1;
      padding-bottom: 0.5rem;
    }
  }

  .act__years {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }
  .act__year {
    display: grid;
    gap: 0.5rem;
  }
  .act__label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .act__label .num {
    font-size: 1.5rem;
    color: var(--ink);
  }
  .act__grid {
    --gap: clamp(1px, 0.25vw, 3px);
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--gap);
    /* 53 columns always, so the years line up under each other. */
    grid-template-columns: repeat(53, minmax(0, 1fr));
  }
  .act__grid i,
  .act__legend i {
    display: block;
    aspect-ratio: 1;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .act__grid i.act__pad {
    background: none;
  }
  [data-l='1'] {
    background: color-mix(in srgb, var(--ink) 30%, transparent) !important;
  }
  [data-l='2'] {
    background: color-mix(in srgb, var(--ink) 52%, transparent) !important;
  }
  [data-l='3'] {
    background: color-mix(in srgb, var(--ink) 76%, transparent) !important;
  }
  [data-l='4'] {
    background: var(--ink) !important;
  }
  .act__grid i.is-hot {
    background: var(--signal) !important;
  }
  @media (min-width: 900px) {
    .act__year {
      grid-template-columns: 9rem 1fr;
      align-items: start;
      gap: 0;
    }
    .act__label {
      flex-direction: column;
      gap: 0.2rem;
    }
  }

  .act__readout {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.35rem 0.6rem;
    background: var(--ink);
    color: var(--ground);
    font-size: var(--t-xs);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--d-s) var(--ease);
  }
  .act__readout.is-on {
    opacity: 1;
  }
  .act__legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 1.25rem;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .act__legend i {
    width: 11px;
  }
  .act__legend span:first-child {
    margin-right: 4px;
  }
  .act__legend span:nth-last-child(2) {
    margin-left: 4px;
  }
  .act__to {
    margin-left: auto;
  }
</style>

<script>
  import { onPage } from '../motion/start';

  // Hover or tap a day to read it.
  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-activity]');
    const readout = root?.querySelector<HTMLElement>('[data-act-readout]');
    if (!root || !readout) return;
    const start = Date.parse(`${root.dataset.from}T00:00:00Z`);
    const fmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    let hot: HTMLElement | null = null;
    const show = (e: PointerEvent) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('i[data-i]');
      if (!cell || cell === hot) return;
      hot?.classList.remove('is-hot');
      hot = cell;
      cell.classList.add('is-hot');
      const c = +cell.dataset.c!;
      readout.textContent = `${fmt.format(new Date(start + +cell.dataset.i! * 864e5))}: ${c === 0 ? 'no' : c} contribution${c === 1 ? '' : 's'}`;
      const r = cell.getBoundingClientRect();
      const box = root.getBoundingClientRect();
      const x = r.left - box.left + r.width / 2;
      readout.style.translate = `${Math.min(Math.max(0, x - readout.offsetWidth / 2), box.width - readout.offsetWidth)}px ${r.top - box.top - readout.offsetHeight - 8}px`;
      readout.classList.add('is-on');
    };
    const hide = () => {
      hot?.classList.remove('is-hot');
      hot = null;
      readout.classList.remove('is-on');
    };
    root.addEventListener('pointerover', show);
    root.addEventListener('pointerdown', show);
    root.addEventListener('pointerleave', hide);
    return () => {
      root.removeEventListener('pointerover', show);
      root.removeEventListener('pointerdown', show);
      root.removeEventListener('pointerleave', hide);
    };
  });
</script>
