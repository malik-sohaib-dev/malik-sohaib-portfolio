---
// The close: the invitation beside a portrait, then everything else in four short columns.
// On pages with their own call to action (About) only the columns and the last line show.
import { Image } from 'astro:assets';
import portrait from '../assets/portrait/studio-grey.webp';
import { site } from '../data/site';
import { posters } from '../data/posters';
interface Props {
  links?: boolean;
}
const { links = false } = Astro.props;
const year = new Date().getFullYear();
const work = Object.values(posters).filter((p) => p.href.startsWith('/work/'));
const outside = { target: '_blank', rel: 'noopener' };
---

<footer class:list={['ftr', { 'ftr--links': links }]} id="contact" data-field="contrast">
  <div class="wrap">
    {
      !links && (
        <div class="ftr__top">
          <div class="ftr__ask">
            <h2 class="ftr__title display">
              Let’s
              <br />
              talk.
            </h2>
            <p class="ftr__lede">
              A project to build, a role to fill, advice you need, an idea to bounce around, a collaboration, or something you want to
              learn. Whatever it is, write to me. Just saying hi is welcome too.
            </p>
            <div class="ftr__actions">
              <a class="btn" href={`mailto:${site.email}`}>
                Email me <span class="btn__arrow" aria-hidden="true">↗</span>
              </a>
              <a class="btn btn--ghost" href={site.whatsapp.href} {...outside}>
                WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <figure class="ftr__me">
            <span class="ftr__photo" data-liquid>
              <Image src={portrait} alt="Malik Sohaib in a black shirt and dark glasses, in black and white." widths={[400, 640, 900]} sizes="(min-width: 900px) 32vw, 70vw" loading="lazy" />
            </span>
            <figcaption>
              <b>{site.name}</b>
              <span>Open to new projects / Remote, worldwide</span>
            </figcaption>
          </figure>
        </div>
      )
    }

    <nav class="ftr__cols" aria-label="Footer">
      <div>
        <h3>Work</h3>
        <ul>
          {
            work.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>More</h3>
        <ul>
          <li><a href="/about">About me</a></li>
          <li><a href="/#path">Path</a></li>
          <li><a href="/#companies">Teams</a></li>
          <li><a href="/#wrapped">Four years, wrapped</a></li>
        </ul>
      </div>
      <div>
        <h3>Elsewhere</h3>
        <ul>
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} {...outside}>
                  {s.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={site.resume} {...outside}>Résumé <span aria-hidden="true">↗</span></a>
          </li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={site.whatsapp.href} {...outside}>WhatsApp {site.whatsapp.label}</a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="ftr__meta">
      <span>© {year} {site.fullName}</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(5rem, 14vw, 11rem) 2rem;
  }
  .ftr--links {
    padding-block: clamp(3rem, 8vw, 5rem) 2rem;
  }
  .ftr__top {
    display: grid;
    gap: 3rem var(--gutter);
  }
  .ftr__title {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .ftr__lede {
    max-width: 30rem;
    margin-top: 2rem;
    color: var(--muted);
  }
  .ftr__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  /* The portrait: a print on the wall, with the mercury under the pointer like every other picture. */
  .ftr__me {
    display: grid;
    gap: 0.9rem;
    width: min(100%, 26rem);
  }
  .ftr__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: #8d8d88;
  }
  .ftr__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .ftr__me figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .ftr__me figcaption b {
    color: var(--ink);
    font-weight: 600;
  }
  @media (min-width: 900px) {
    .ftr__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .ftr__ask {
      grid-column: 1 / 8;
    }
    .ftr__me {
      grid-column: 9 / -1;
      justify-self: end;
    }
  }

  /* Four short columns: the work, the rest of the site, elsewhere, and how to reach me. */
  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem var(--gutter);
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .ftr--links .ftr__cols {
    margin-top: 0;
  }
  @media (min-width: 900px) {
    .ftr__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ftr__cols h3 {
    margin-bottom: 0.9rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ftr__cols ul {
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }
  .ftr__cols a,
  .ftr__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--d-s) var(--ease);
  }
  .ftr__cols a span {
    margin-left: 0.3em;
    color: var(--muted);
  }
  @media (hover: hover) {
    .ftr__cols a:hover {
      color: var(--muted);
    }
    .ftr__meta a:hover {
      color: var(--ink);
    }
  }
  .ftr__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    color: var(--muted);
  }
</style>
