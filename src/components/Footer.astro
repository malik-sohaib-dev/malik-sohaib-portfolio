---
import { site } from '../data/site';
interface Props {
  links?: boolean;
}
const { links = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['ftr', { 'ftr--links': links }]} id="contact" data-field="ink">
  <div class="wrap">
    {
      !links && (
        <>
          <h2 class="ftr__title display">
            Next commit:
            <br />
            yours.
          </h2>
          <p class="ftr__lede">Tell me what you want to build and when you need it. A few lines is enough to start.</p>
          <div class="ftr__actions">
            <a class="btn" href={`mailto:${site.email}`}>
              Email me <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">
              WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </>
      )
    }
    <div class="ftr__meta">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.resume} rel="noopener">Résumé</a>
      {site.socials.map((s) => <a href={s.href} rel="noopener">{s.label}</a>)}
      <span>© {year} {site.fullName}</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(5rem, 14vw, 11rem) 2rem;
  }
  .ftr--links {
    padding-block: 1rem 2rem;
  }
  .ftr--links .ftr__meta {
    margin-top: 0;
  }
  .ftr__title {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .ftr__lede {
    max-width: 30rem;
    margin-top: 2rem;
    color: var(--muted);
  }
  .ftr__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .ftr__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .ftr__meta a {
    text-decoration: none;
    min-height: 24px;
    transition: color var(--d-s) var(--ease);
  }
  @media (hover: hover) {
    .ftr__meta a:hover {
      color: var(--ink);
    }
  }
  .ftr__meta span {
    margin-left: auto;
  }
</style>
