---
// The close, on every page: the invitation (pick what it is about and the email starts itself; or
// take the address from the marquee), then my full name under my silhouette in soft light
// (art/portrait.py; the mercury stirs it like every picture), then four short columns.
import { Image } from 'astro:assets';
import glow from '../assets/portrait/profile-glow.webp';
import { site } from '../data/site';
import { posters } from '../data/posters';
const year = new Date().getFullYear();
const work = Object.values(posters).filter((p) => p.href.startsWith('/work/'));
const outside = { target: '_blank', rel: 'noopener' };
// What people write about; each starts an email with that as its subject.
const topics = ['A project to build', 'A role to fill', 'Advice', 'An idea to bounce around', 'A collaboration', 'Something to learn', 'Just saying hi'];
const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<footer class="ftr" id="contact" data-field="base">
  <div class="wrap ftr__ask">
    <h2 class="ftr__title display">
      Let’s
      <br />
      talk.
    </h2>
    <div class="ftr__side">
      <p class="ftr__lede">Whatever it is, write to me. Pick what it’s about and the email starts itself.</p>
      <ul class="ftr__topics">
        {
          topics.map((t) => (
            <li>
              <a class="btn btn--ghost" href={mailto(t)}>
                {t}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <a class="ftr__mail display" href={`mailto:${site.email}`} data-cursor="Write to me">
    <span class="ftr__track" aria-hidden="true">
      {Array.from({ length: 4 }, () => <span>{site.email}</span>)}
    </span>
    <span class="sr-only">{site.email}</span>
  </a>
  <div class="wrap ftr__actions">
    <button class="btn" type="button" data-copy={site.email}><span data-copy-label>Copy email</span></button>
    <a class="btn btn--ghost" href={site.whatsapp.href} {...outside}>
      WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="ftr__stage" data-liquid-surface>
    <span class="ftr__glow" data-liquid>
      <Image src={glow} alt="Malik Sohaib in profile, a silhouette against soft light." widths={[800, 1400, 2400]} sizes="100vw" loading="lazy" />
    </span>
    <p class="ftr__name display" data-fit><span>Malik Sohaib Ahmad</span></p>
  </div>
  <div class="wrap">
    <nav class="ftr__cols" aria-label="Footer">
      <div>
        <h3>Work</h3>
        <ul>
          {
            work.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>More</h3>
        <ul>
          <li><a href="/about">About me</a></li>
          <li><a href="/#path">Path</a></li>
          <li><a href="/#companies">Teams</a></li>
          <li><a href="/#wrapped">Four years, wrapped</a></li>
        </ul>
      </div>
      <div>
        <h3>Elsewhere</h3>
        <ul>
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} {...outside}>
                  {s.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={site.resume} {...outside}>Résumé <span aria-hidden="true">↗</span></a>
          </li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={site.whatsapp.href} {...outside}>WhatsApp {site.whatsapp.label}</a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="ftr__meta">
      <span>© {year} {site.fullName}</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>

<script>
  import { onPage } from '../motion/start';

  // Copy the address; where the clipboard is refused, open the mail app instead.
  onPage(() => {
    const btn = document.querySelector<HTMLButtonElement>('.ftr [data-copy]');
    if (!btn) return;
    const out = btn.querySelector('[data-copy-label]')!;
    const copy = async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        out.textContent = 'Copied';
        setTimeout(() => (out.textContent = 'Copy email'), 1600);
      } catch {
        location.href = `mailto:${btn.dataset.copy}`;
      }
    };
    btn.addEventListener('click', copy);
    return () => btn.removeEventListener('click', copy);
  });

  // The name fills the width exactly, on one line, at any size: measured at 100px and scaled.
  onPage(() => {
    const box = document.querySelector<HTMLElement>('[data-fit]');
    if (!box) return;
    const text = box.firstElementChild as HTMLElement;
    const fit = () => {
      box.style.fontSize = '100px';
      box.style.fontSize = `${(100 * box.clientWidth) / text.getBoundingClientRect().width - 0.1}px`;
    };
    const ro = new ResizeObserver(fit);
    ro.observe(box);
    document.fonts.ready.then(fit);
    return () => ro.disconnect();
  });
</script>

<style>
  .ftr {
    padding-bottom: 2rem;
  }
  /* The invitation: the words on the left; on the right, what it might be about, each a way in. */
  .ftr__ask {
    display: grid;
    gap: 2rem var(--gutter);
    padding-block: clamp(4.5rem, 9vw, 7rem) clamp(2rem, 4vw, 3rem);
  }
  .ftr__title {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .ftr__lede {
    max-width: 30rem;
    color: var(--muted);
  }
  .ftr__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }
  .ftr__topics .btn {
    --h: 2.6rem;
    font-weight: 500;
  }
  @media (min-width: 900px) {
    .ftr__ask {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .ftr__title {
      grid-column: 1 / 7;
    }
    .ftr__side {
      grid-column: 7 / -1;
      padding-bottom: 0.6rem;
    }
  }
  /* The address as a giant marquee: it pauses under the pointer. */
  .ftr__mail {
    position: relative;
    display: block;
    overflow: clip;
    font-size: clamp(3.5rem, 12vw, 11rem);
    /* Room for the @ and the descenders: the marquee clips its box. */
    line-height: 1.2;
    padding-block: 0.02em 0.08em;
    text-decoration: none;
    text-transform: none;
    white-space: nowrap;
  }
  .ftr__track {
    display: inline-flex;
    gap: 0.5em;
    padding-right: 0.5em;
  }
  :global(html.motion) .ftr__track {
    animation: ftr-marquee 26s linear infinite;
  }
  @media (hover: hover) {
    :global(html.motion) .ftr__mail:hover .ftr__track {
      animation-play-state: paused;
    }
  }
  @keyframes ftr-marquee {
    to {
      translate: -50% 0;
    }
  }
  .ftr__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-block: 1rem clamp(3rem, 6vw, 4.5rem);
  }

  /* The stage: the silhouette edge to edge, the whole figure in view, my name across its foot. */
  .ftr__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 100svh;
    width: 100%;
    overflow: hidden;
    background: #0b0b0b;
  }
  @media (max-width: 899px) {
    .ftr__stage {
      aspect-ratio: 4 / 5;
    }
  }
  .ftr__glow {
    position: absolute;
    inset: 0;
  }
  .ftr__glow :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .ftr__name {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    bottom: clamp(0.75rem, 2.4vw, 2rem);
    z-index: 1;
    color: #ededE7;
    font-size: 10vw; /* before the script fits it */
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.005em;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
  }
  .ftr__name span {
    display: inline-block;
  }

  /* Four short columns: the work, the rest of the site, elsewhere, and how to reach me. */
  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem var(--gutter);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .ftr__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ftr__cols h3 {
    margin-bottom: 0.9rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ftr__cols ul {
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }
  .ftr__cols a,
  .ftr__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--d-s) var(--ease);
  }
  .ftr__cols a span {
    margin-left: 0.3em;
    color: var(--muted);
  }
  @media (hover: hover) {
    .ftr__cols a:hover {
      color: var(--muted);
    }
    .ftr__meta a:hover {
      color: var(--ink);
    }
  }
  .ftr__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    color: var(--muted);
  }
</style>
