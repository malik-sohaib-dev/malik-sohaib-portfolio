---
// The close: the invitation, then my full name over my portrait as a mosaic that resolves as it
// comes into view and sharpens under the pointer (src/motion/mosaic.ts), then four short columns.
// On pages with their own call to action (About) the invitation is left out.
import { getImage } from 'astro:assets';
import light from '../assets/portrait/profile-light.webp';
import { site } from '../data/site';
import { posters } from '../data/posters';
interface Props {
  links?: boolean;
}
const { links = false } = Astro.props;
const year = new Date().getFullYear();
const work = Object.values(posters).filter((p) => p.href.startsWith('/work/'));
const outside = { target: '_blank', rel: 'noopener' };
// The photo the mosaic averages down, and a tiny copy that is the mosaic before (or without) script.
const full = await getImage({ src: light, width: 1254, format: 'webp' });
const tiny = await getImage({ src: light, width: 72, format: 'webp' });
---

<footer class:list={['ftr', { 'ftr--links': links }]} id="contact" data-field="base">
  {
    !links && (
      <div class="wrap ftr__ask">
        <h2 class="ftr__title display">
          Let’s
          <br />
          talk.
        </h2>
        <div class="ftr__side">
          <p class="ftr__lede">
            A project to build, a role to fill, advice you need, an idea to bounce around, a collaboration, or something you want to
            learn. Whatever it is, write to me. Just saying hi is welcome too.
          </p>
          <div class="ftr__actions">
            <a class="btn" href={`mailto:${site.email}`}>
              Email me <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a class="btn btn--ghost" href={site.whatsapp.href} {...outside}>
              WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    )
  }
  <div class="ftr__stage" data-mosaic data-src={full.src} data-focus-x="0.42" data-focus-y="0.36">
    <img class="ftr__tiny" src={tiny.src} alt="Malik Sohaib in profile, lit from behind, as a mosaic." width="72" height="72" loading="lazy" />
    <canvas aria-hidden="true"></canvas>
    <p class="ftr__name display"><span>Malik</span> <span>Sohaib</span> <span>Ahmad</span></p>
  </div>
  <div class="wrap">
    <nav class="ftr__cols" aria-label="Footer">
      <div>
        <h3>Work</h3>
        <ul>
          {
            work.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3>More</h3>
        <ul>
          <li><a href="/about">About me</a></li>
          <li><a href="/#path">Path</a></li>
          <li><a href="/#companies">Teams</a></li>
          <li><a href="/#wrapped">Four years, wrapped</a></li>
        </ul>
      </div>
      <div>
        <h3>Elsewhere</h3>
        <ul>
          {
            site.socials.map((s) => (
              <li>
                <a href={s.href} {...outside}>
                  {s.label} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={site.resume} {...outside}>Résumé <span aria-hidden="true">↗</span></a>
          </li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>
            <a href={site.whatsapp.href} {...outside}>WhatsApp {site.whatsapp.label}</a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="ftr__meta">
      <span>© {year} {site.fullName}</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>

<script>
  import { onPage } from '../motion/start';
  import { mosaic } from '../motion/mosaic';

  onPage(() => {
    const stage = document.querySelector<HTMLElement>('[data-mosaic]');
    return stage ? mosaic(stage) : undefined;
  });
</script>

<style>
  .ftr {
    padding-bottom: 2rem;
  }
  /* The invitation: the words on the left, what to do about them on the right. */
  .ftr__ask {
    display: grid;
    gap: 2rem var(--gutter);
    padding-block: clamp(5rem, 12vw, 9rem) clamp(3rem, 7vw, 5rem);
  }
  .ftr__title {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .ftr__lede {
    max-width: 30rem;
    color: var(--muted);
  }
  .ftr__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .ftr__ask {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .ftr__title {
      grid-column: 1 / 8;
    }
    .ftr__side {
      grid-column: 8 / -1;
      padding-bottom: 0.6rem;
    }
  }

  /* The stage: the portrait edge to edge as a mosaic, my name across its foot. Before the script
     draws (or without it), a 72px copy scaled up without smoothing is the mosaic. */
  .ftr__stage {
    position: relative;
    height: min(92svh, 62vw);
    min-height: 420px;
    overflow: hidden;
    background: #0b0b0b;
  }
  @media (max-width: 899px) {
    .ftr__stage {
      height: 128vw;
    }
  }
  .ftr__tiny,
  .ftr__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ftr__tiny {
    object-fit: cover;
    object-position: 42% 42%;
    image-rendering: pixelated;
  }
  .ftr__stage canvas {
    opacity: 0;
    transition: opacity 400ms linear;
  }
  .ftr__stage:global(.is-drawn) canvas {
    opacity: 1;
  }
  /* The name inverts what is under it, like the cursor: light on the dark figure, dark on the light. */
  .ftr__name {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    bottom: clamp(0.5rem, 2vw, 1.5rem);
    z-index: 1;
    color: #fff;
    mix-blend-mode: difference;
    font-size: 10.4vw;
    line-height: 0.82;
    letter-spacing: -0.01em;
    white-space: nowrap;
    pointer-events: none;
  }
  @media (max-width: 899px) {
    .ftr__name {
      font-size: 19vw;
      white-space: normal;
    }
    .ftr__name span {
      display: block;
    }
  }

  /* Four short columns: the work, the rest of the site, elsewhere, and how to reach me. */
  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem var(--gutter);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .ftr__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ftr__cols h3 {
    margin-bottom: 0.9rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ftr__cols ul {
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }
  .ftr__cols a,
  .ftr__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--d-s) var(--ease);
  }
  .ftr__cols a span {
    margin-left: 0.3em;
    color: var(--muted);
  }
  @media (hover: hover) {
    .ftr__cols a:hover {
      color: var(--muted);
    }
    .ftr__meta a:hover {
      color: var(--ink);
    }
  }
  .ftr__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    color: var(--muted);
  }
</style>
