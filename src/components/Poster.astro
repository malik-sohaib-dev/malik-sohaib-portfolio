---
// A project poster. Layers, back to front: grayscale art (or a studio ground), the real product
// (revealed from the pointer on hover), the liquid-chrome object, the type, the frame.
import { Image } from 'astro:assets';
import type { Poster } from '../data/posters';

interface Props {
  poster: Poster;
  /** Rendered width in the layout, for responsive image sizes. */
  sizes?: string;
  eager?: boolean;
}
const { poster: p, sizes = '(min-width: 900px) 40vw, 92vw', eager = false } = Astro.props;
const external = /^https?:/.test(p.href);
const loading = eager ? 'eager' : 'lazy';
---

<a
  class:list={['poster', `poster--${p.ground}`]}
  href={p.href}
  {...external ? { rel: 'noopener' } : {}}
  data-poster
  data-cursor={p.reveal.kind === 'video' ? 'Play' : external ? 'Visit' : 'View'}
  aria-label={`${p.title}: ${p.caption}`}
>
  <span class="poster__bg" aria-hidden="true">
    {p.bg && <Image src={p.bg} alt="" widths={[480, 720, 1200]} sizes={sizes} loading={loading} />}
  </span>

  <span class="poster__reveal" aria-hidden="true">
    {p.reveal.kind === 'image' && <Image src={p.reveal.src} alt="" widths={[480, 960]} sizes={sizes} loading="lazy" />}
    {
      p.reveal.kind === 'video' && (
        <video muted loop playsinline preload="none" poster={p.reveal.poster.src} data-poster-video>
          <source src={`${p.reveal.src}.webm`} type='video/webm; codecs="av01.0.05M.08"' />
          <source src={`${p.reveal.src}.mp4`} type="video/mp4" />
        </video>
      )
    }
    {p.reveal.kind === 'fact' && <span class="poster__fact display">{p.reveal.text}</span>}
  </span>

  <span class="poster__chrome" aria-hidden="true">
    <Image src={p.chrome} alt="" widths={[400, 720, 1200]} sizes={sizes} loading={loading} />
  </span>

  <span class="poster__meta poster__tl" aria-hidden="true"><span class="poster__num num">{p.index}</span>{p.kind}</span>
  <span class="poster__meta poster__tr" aria-hidden="true">{p.meta.map((m) => <span>{m}</span>)}</span>
  <span class="poster__title display">{p.title}</span>
  <span class="poster__meta poster__bl" aria-hidden="true">{p.caption}</span>
  <span class="poster__meta poster__br" aria-hidden="true">
    {p.live && <span class="poster__dot" />}{p.status}{external && ' ↗'}
  </span>
  <span class="poster__frame" aria-hidden="true"></span>
</a>

<style>
  .poster {
    --pad: clamp(14px, 4.5cqi, 28px);
    --fg: #f0f0ec;
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
    color: var(--fg);
    text-decoration: none;
    background: #0d0d0c;
  }
  .poster--light {
    --fg: #111110;
    background: radial-gradient(120% 90% at 30% 15%, #f2f2ee 0%, #c9c9c4 55%, #9d9d97 100%);
  }
  .poster__bg,
  .poster__reveal,
  .poster__chrome,
  .poster__frame {
    position: absolute;
    inset: 0;
  }
  .poster__bg :global(img),
  .poster__reveal :global(img),
  .poster__reveal video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Shade the art so the corner type always reads. */
  .poster--dark .poster__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.55), transparent 28%, transparent 55%, rgb(0 0 0 / 0.85));
  }

  /* The real product floods in from the pointer, like a drop landing. */
  .poster__reveal {
    z-index: 1;
    clip-path: circle(0% at var(--mx, 50%) var(--my, 50%));
    transition: clip-path 900ms var(--ease);
    background: #111110;
  }
  .poster--light .poster__reveal {
    background: var(--signal);
  }
  /* A scrim over the product, so the corner type and the title stay readable on any screen. */
  .poster--dark .poster__reveal::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.6), transparent 26%, transparent 45%, rgb(0 0 0 / 0.88));
  }
  .poster__fact {
    position: absolute;
    left: var(--pad);
    right: var(--pad);
    top: 46%;
    font-size: clamp(1.6rem, 11cqi, 4rem);
    line-height: 0.9;
    color: #111110;
  }

  .poster__chrome {
    z-index: 2;
    transition:
      translate var(--d-l) var(--ease),
      scale var(--d-l) var(--ease),
      opacity var(--d-m) var(--ease);
  }
  .poster__chrome :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 50%;
    scale: 0.62;
    translate: 0 -14%;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35));
  }

  .poster__meta {
    position: absolute;
    z-index: 3;
    display: grid;
    font-size: clamp(0.6875rem, 3.2cqi, 0.875rem);
    line-height: 1.3;
    font-weight: 500;
  }
  .poster__tl {
    top: var(--pad);
    left: var(--pad);
  }
  .poster__num {
    font-size: 1.6em;
    line-height: 1;
  }
  .poster__tr {
    top: var(--pad);
    right: var(--pad);
    text-align: right;
  }
  .poster__bl {
    bottom: var(--pad);
    left: var(--pad);
    max-width: 62%;
  }
  .poster__br {
    bottom: var(--pad);
    right: var(--pad);
    display: flex;
    align-items: center;
    gap: 0.45em;
  }
  .poster__dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--signal);
  }
  .poster__title {
    position: absolute;
    z-index: 3;
    left: calc(var(--pad) - 0.04em);
    right: var(--pad);
    bottom: calc(var(--pad) + 13cqi);
    font-size: clamp(2.5rem, 19cqi, 8.5rem);
    line-height: 0.82;
    transition: translate var(--d-l) var(--ease);
  }
  .poster__frame {
    z-index: 4;
    inset: calc(var(--pad) / 2);
    border: 1px solid currentColor;
    opacity: 0.3;
  }

  @media (hover: hover) {
    .poster:hover .poster__reveal,
    .poster:focus-visible .poster__reveal {
      clip-path: circle(150% at var(--mx, 50%) var(--my, 50%));
    }
    /* Over a product the chrome evaporates; over a fact it lifts out of the way. */
    .poster--dark:hover .poster__chrome,
    .poster--dark:focus-visible .poster__chrome {
      opacity: 0;
      scale: 1.12;
    }
    .poster--light:hover .poster__chrome,
    .poster--light:focus-visible .poster__chrome {
      translate: 0 -6%;
      scale: 0.9;
    }
    /* Over the product the type turns light, so it reads on any reveal. */
    .poster:hover,
    .poster:focus-visible {
      --fg: #f0f0ec;
    }
    .poster--light:hover,
    .poster--light:focus-visible {
      --fg: #111110;
    }
    .poster:hover .poster__title {
      translate: 0 -0.08em;
    }
  }
  .poster:active .poster__chrome {
    scale: 0.98;
  }
</style>

<script>
  import { onPage } from '../motion/start';

  // The reveal starts where the pointer enters; a poster's clip plays only while it is hovered.
  onPage(() => {
    const enter = (e: PointerEvent) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-poster]');
      if (!el || e.pointerType === 'touch') return;
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      el.querySelector<HTMLVideoElement>('[data-poster-video]')?.play().catch(() => {});
    };
    const leave = (e: PointerEvent) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-poster]');
      if (!el || el.contains(e.relatedTarget as Node)) return;
      el.querySelector<HTMLVideoElement>('[data-poster-video]')?.pause();
    };
    document.addEventListener('pointerover', enter);
    document.addEventListener('pointerout', leave);
    return () => {
      document.removeEventListener('pointerover', enter);
      document.removeEventListener('pointerout', leave);
    };
  });
</script>
