---
// A project poster: one grayscale Blender scene (art/blender/poster.py) with real type on top.
// On hover, src/motion/liquid.ts lays a WebGL canvas over the art and runs liquid glass through it.
import { Image } from 'astro:assets';
import type { Poster } from '../data/posters';

interface Props {
  poster: Poster;
  /** Rendered width in the layout, for responsive image sizes. */
  sizes?: string;
  eager?: boolean;
  /** Morph into the same poster on the next page (view transitions). One per page. */
  morph?: boolean;
  /** A preview inside a decorative container: not a link, and out of the accessibility tree. */
  decorative?: boolean;
}
const { poster: p, sizes = '(min-width: 900px) 40vw, 92vw', eager = false, morph = false, decorative = false } = Astro.props;
const external = /^https?:/.test(p.href);
const Tag = decorative ? 'div' : 'a';
---

<Tag
  class="poster"
  {...decorative ? { 'aria-hidden': 'true' } : { href: p.href, 'data-cursor': external ? 'Visit' : 'View', ...(external ? { rel: 'noopener' } : {}) }}
  data-poster
  style={morph ? `view-transition-name: poster-${p.slug}` : undefined}
>
  <span class="poster__bg" aria-hidden="true">
    <Image src={p.art} alt="" widths={[480, 720, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
  </span>
  <span class="poster__meta poster__tl" aria-hidden="true"><span class="poster__num num">{p.index}</span>{p.kind}</span>
  <span class="poster__meta poster__tr" aria-hidden="true">{p.meta.map((m) => <span>{m}</span>)}</span>
  <span class="poster__title display">{p.title}</span>
  <span class="sr-only">: {p.caption}</span>
  <span class="poster__meta poster__bl" aria-hidden="true">{p.caption}</span>
  <span class="poster__meta poster__br" aria-hidden="true">
    {p.live && <span class="poster__dot" />}{p.status}{external && ' ↗'}
  </span>
  <span class="poster__frame" aria-hidden="true"></span>
</Tag>

<style>
  .poster {
    --pad: clamp(14px, 4.5cqi, 28px);
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
    color: #f0f0ec;
    text-decoration: none;
    background: #050505;
  }
  .poster__bg {
    position: absolute;
    inset: 0;
    transition: scale var(--d-l) var(--ease);
  }
  .poster__bg :global(img),
  .poster__bg :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster__bg :global(canvas) {
    opacity: 0;
    transition: opacity 200ms linear;
  }

  .poster__meta {
    position: absolute;
    z-index: 3;
    display: grid;
    font-size: clamp(0.6875rem, 3.2cqi, 0.875rem);
    line-height: 1.3;
    font-weight: 500;
  }
  .poster__tl {
    top: var(--pad);
    left: var(--pad);
  }
  .poster__num {
    font-size: 1.6em;
    line-height: 1;
  }
  .poster__tr {
    top: var(--pad);
    right: var(--pad);
    text-align: right;
  }
  .poster__bl {
    bottom: var(--pad);
    left: var(--pad);
    max-width: 62%;
    color: rgb(240 240 236 / 0.75);
  }
  .poster__br {
    bottom: var(--pad);
    right: var(--pad);
    display: flex;
    align-items: center;
    gap: 0.45em;
  }
  .poster__dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.25em rgb(240 240 236 / 0.2);
  }
  /* The title sits in the dark space the scenes leave above their subject. */
  .poster__title {
    position: absolute;
    z-index: 3;
    top: calc(var(--pad) + 12cqi);
    left: calc(var(--pad) - 0.04em);
    right: var(--pad);
    font-size: min(17cqi, 8rem);
    line-height: 0.84;
    transition: translate var(--d-l) var(--ease);
  }
  .poster__frame {
    position: absolute;
    z-index: 4;
    inset: calc(var(--pad) / 2);
    border: 1px solid currentColor;
    opacity: 0.22;
    pointer-events: none;
    transition:
      inset var(--d-m) var(--ease),
      opacity var(--d-m) var(--ease);
  }
  @container (max-width: 280px) {
    .poster__bl {
      display: none;
    }
  }
  @media (hover: hover) {
    .poster:hover .poster__title,
    .poster:focus-visible .poster__title {
      translate: 0 -0.06em;
    }
    .poster:hover .poster__frame,
    .poster:focus-visible .poster__frame {
      opacity: 0.5;
    }
    /* Without the WebGL glass (reduced motion, no WebGL), the art still answers: a slow push in. */
    :global(html:not(.liquid-on)) .poster:hover .poster__bg {
      scale: 1.04;
    }
  }
  .poster:active .poster__frame {
    inset: calc(var(--pad) / 2 + 3px);
  }
</style>
