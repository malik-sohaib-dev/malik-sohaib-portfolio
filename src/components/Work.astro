---
import Poster from './Poster.astro';
import { products } from '../data/site';
import { posters } from '../data/posters';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
---

<section class="work" id="work" data-field="ink" aria-labelledby="work-title">
  <div class="wrap work__head">
    <h2 class="work__title display" id="work-title">Owned end to end</h2>
    <p class="work__intro">
      In 2026 I took three ideas of my own to production, alone: the product thinking, the design, every layer of code, and the
      launch. They show how I work for clients too. I write every decision down, so each case study shows what I chose and why.
    </p>
  </div>

  {
    products.map((p, k) => (
      <article class:list={['band', { 'band--flip': k % 2 === 1 }]} id={p.slug} aria-labelledby={`${p.slug}-name`}>
        <div class="wrap">
          <div class="band__grid">
            <div class="band__text">
              <p class="band__meta">
                <span class:list={['chip', { 'chip--live': p.status === 'Live' }]}>{p.status}</span>
                <span class="band__since">Since {fmt(p.started)}</span>
                {p.url && (
                  <a class="band__url ul" href={p.url} rel="noopener">
                    {p.urlLabel} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
              <h3 class="band__name display" id={`${p.slug}-name`}>
                {p.name}
              </h3>
              <p class="band__summary">{p.summary}</p>
              <dl class="band__stats">
                {p.stats.map((s) => (
                  <div class="stat">
                    <dt class="stat__label">{s.label}</dt>
                    <dd class="stat__value num">{s.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="band__stack">
                <span class="sr-only">Built with </span>
                {p.stack.join(', ')}
              </p>
              <a class="btn btn--ghost band__cta" href={`/work/${p.slug}`}>
                Read the case study <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>

            <div class="band__media">
              <Poster poster={posters[p.slug]} sizes="(min-width: 900px) 42vw, 92vw" morph />
            </div>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .work {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(2rem, 5vw, 4rem);
  }
  .work__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }
  .work__title {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .work__intro {
    max-width: 38rem;
    font-size: var(--t-m);
    line-height: 1.4;
  }
  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .work__title {
      grid-column: 1 / 7;
    }
    .work__intro {
      grid-column: 7 / -1;
      padding-bottom: 0.6rem;
    }
  }

  .band {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .band__since {
    color: var(--muted);
  }
  .band__grid {
    display: grid;
    gap: 2.5rem;
  }
  .band__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .band__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    font-size: var(--t-s);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: var(--t-xs);
    font-weight: 600;
  }
  .chip--live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 1.5px var(--ink);
  }
  .band__url {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .band__name {
    font-size: var(--t-xl);
    margin-left: -0.04em;
  }
  .band__summary {
    max-width: 36rem;
  }
  .band__stats {
    display: grid;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .stat {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .stat__value {
    order: -1;
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .stat__label {
    font-size: var(--t-s);
    line-height: 1.35;
    color: var(--muted);
  }
  .band__stack {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .band__cta {
    justify-self: start;
    margin-top: 0.5rem;
  }

  /* Phones show the poster first: the work is the hook, the text explains it. */
  .band__media {
    order: -1;
  }

  @media (min-width: 900px) {
    .band__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .band__text {
      grid-column: 1 / 6;
    }
    .band__media {
      grid-column: 7 / 12;
      order: 0;
    }
    .band--flip .band__text {
      grid-column: 8 / -1;
      grid-row: 1;
    }
    .band--flip .band__media {
      grid-column: 2 / 7;
      grid-row: 1;
    }
  }
</style>
