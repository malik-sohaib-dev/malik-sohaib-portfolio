---
import { Image } from 'astro:assets';
import Strip from './Strip.astro';
import { commitData, products } from '../data/site';
import ezHome from '../assets/work/ezvenda-home.webp';
import ezProduct from '../assets/work/ezvenda-product.webp';
import ezCheckout from '../assets/work/ezvenda-checkout.webp';
import mhSumo from '../assets/work/mini-havoc-sumo.jpg';
import mhHush from '../assets/work/mini-havoc-hush.jpg';
import mhFloor from '../assets/work/mini-havoc-floor.jpg';
import mhHex from '../assets/work/mini-havoc-hexdrop.jpg';
import gpCard from '../assets/work/gympaid-card.png';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
const commitsFor = (slug: string) => ((commitData.series as Record<string, number[]>)[slug] ?? []).reduce((a, b) => a + b, 0);
const phoneSizes = '(min-width: 900px) 18vw, 30vw';
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="wrap work__head">
    <h2 class="work__title display" id="work-title">Work</h2>
    <p class="work__intro">
      Three products of my own, each built end to end: design, frontend, backend, AI and launch. Every one keeps a written log of
      the decisions behind it, so the case studies show what I chose and why.
    </p>
  </div>

  {
    products.map((p, k) => (
      <article class:list={['band', { 'band--flip': k % 2 === 1 }]} id={p.slug} aria-labelledby={`${p.slug}-name`}>
        <div class="wrap">
          <div class="band__time">
            <Strip variant="mini" highlight={p.slug} />
            <p class="band__time-cap">
              <span class="num">{commitsFor(p.slug).toLocaleString('en-US')}</span> commits since {fmt(p.started)}
            </p>
          </div>
          <div class="band__grid">
            <div class="band__text">
              <p class="band__meta">
                <span class:list={['chip', { 'chip--live': p.status === 'Live' }]}>{p.status}</span>
                {p.url && (
                  <a class="band__url ul" href={p.url} rel="noopener">
                    {p.urlLabel} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
              <h3 class="band__name display" id={`${p.slug}-name`}>
                {p.name}
              </h3>
              <p class="band__summary">{p.summary}</p>
              <dl class="band__stats">
                {p.stats.map((s) => (
                  <div class="stat">
                    <dt class="stat__label">{s.label}</dt>
                    <dd class="stat__value num">{s.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="band__stack">
                <span class="sr-only">Built with </span>
                {p.stack.join(', ')}
              </p>
              <a class="btn btn--ghost band__cta" href={`/work/${p.slug}`}>
                Read the case study <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>

            <div class:list={['band__media', `band__media--${p.slug}`]}>
              {p.slug === 'ezvenda' && (
                <div class="phones">
                  <Image src={ezHome} alt="An EzVenda shop's home page on a phone." widths={[240, 360, 480]} sizes={phoneSizes} loading="lazy" />
                  <Image src={ezProduct} alt="A product page with price, discount and photos." widths={[240, 360, 480]} sizes={phoneSizes} loading="lazy" />
                  <Image src={ezCheckout} alt="The guest checkout form, asking for a phone number for cash on delivery." widths={[240, 360, 480]} sizes={phoneSizes} loading="lazy" />
                </div>
              )}
              {p.slug === 'mini-havoc' && (
                <div class="arena">
                  <figure class="clip" data-video>
                    <video data-autoplay muted loop playsinline preload="none" poster={mhSumo.src} width="960" height="540" aria-label={p.media.alt}>
                      <source src="/media/mini-havoc-sumo.webm" type='video/webm; codecs="av01.0.05M.08"' />
                      <source src="/media/mini-havoc-sumo.mp4" type="video/mp4" />
                    </video>
                    <button class="clip__toggle" type="button" data-video-toggle aria-pressed="false">
                      <span data-video-label>Play</span>
                      <span class="sr-only"> the Sumo Out! clip</span>
                    </button>
                    <figcaption class="clip__cap">Sumo Out!, recorded from a real game</figcaption>
                  </figure>
                  <ul class="arena__stills" aria-label="Three more arenas">
                    <li><Image src={mhHush} alt="Hush: first-person view down a haunted house corridor." widths={[320, 480]} sizes="(min-width: 900px) 18vw, 30vw" loading="lazy" /><span>Hush</span></li>
                    <li><Image src={mhFloor} alt="Colour Floor: beans racing across a grid of coloured tiles." widths={[320, 480]} sizes="(min-width: 900px) 18vw, 30vw" loading="lazy" /><span>Colour Floor</span></li>
                    <li><Image src={mhHex} alt="Hex Drop: beans on a honeycomb floor that falls away." widths={[320, 480]} sizes="(min-width: 900px) 18vw, 30vw" loading="lazy" /><span>Hex Drop</span></li>
                  </ul>
                </div>
              )}
              {p.slug === 'gympaid' && (
                <Image class="card" src={gpCard} alt="GymPaid's card: who owes you money today, with Rs 26,000 owed by seven members and a WhatsApp Remind button." widths={[480, 720, 1080]} sizes="(min-width: 900px) 55vw, 100vw" loading="lazy" />
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .work {
    padding-block: clamp(5rem, 12vw, 10rem) 0;
  }
  .work__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }
  .work__title {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .work__intro {
    max-width: 38rem;
    font-size: var(--t-m);
    line-height: 1.4;
  }
  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .work__title {
      grid-column: 1 / 6;
    }
    .work__intro {
      grid-column: 7 / -1;
      padding-bottom: 0.6rem;
    }
  }

  .band {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1.5px solid var(--ink);
  }
  .band__time {
    display: grid;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .band__time-cap {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .band__time-cap .num {
    font-size: 1.1rem;
    color: var(--ink);
  }
  .band__grid {
    display: grid;
    gap: 2.5rem;
  }
  .band__text {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .band__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    font-size: var(--t-s);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: var(--t-xs);
    font-weight: 600;
  }
  .chip--live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 1.5px var(--ink);
  }
  .band__url {
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .band__name {
    font-size: var(--t-xl);
    margin-left: -0.04em;
  }
  .band__summary {
    max-width: 36rem;
  }
  .band__stats {
    display: grid;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .stat {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .stat__value {
    order: -1;
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .stat__label {
    font-size: var(--t-s);
    line-height: 1.35;
    color: var(--muted);
  }
  .band__stack {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .band__cta {
    justify-self: start;
    margin-top: 0.5rem;
  }

  /* Media. Phones show it first: the work is the hook, the text explains it. */
  .band__media {
    order: -1;
  }
  .band__media :global(img) {
    width: 100%;
    height: auto;
  }
  .phones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.5vw, 20px);
    align-items: start;
  }
  .phones :global(img) {
    aspect-ratio: 780 / 1688;
    object-fit: cover;
    object-position: top;
    max-height: 72vh;
    border: 1px solid var(--line);
    transition: translate var(--d-m) var(--ease);
  }
  /* Hung at different heights, like screens pinned to a wall. */
  .phones :global(img:nth-child(2)) {
    margin-top: 12%;
  }
  .phones :global(img:nth-child(3)) {
    margin-top: 5%;
  }
  .arena {
    display: grid;
    gap: clamp(8px, 1.5vw, 20px);
  }
  .clip {
    position: relative;
    background: var(--ink);
  }
  .clip video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .clip__toggle {
    position: absolute;
    left: 12px;
    bottom: 12px;
    min-height: 32px;
    padding: 0 0.85rem;
    border: 0;
    border-radius: 999px;
    background: var(--ground);
    color: var(--ink);
    font-size: var(--t-xs);
    font-weight: 600;
    cursor: pointer;
  }
  .clip__cap {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 0.25rem 0.55rem;
    background: rgb(17 17 16 / 0.72);
    color: var(--ground);
    font-size: var(--t-xs);
  }
  .arena__stills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.5vw, 20px);
  }
  .arena__stills li {
    display: grid;
    gap: 0.4rem;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .arena__stills :global(img) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .band__media--gympaid :global(img) {
    border: 1px solid var(--line);
    transition: translate var(--d-m) var(--ease);
  }

  /* Hovering a band lights its days on its strip and lifts its media. */
  @media (hover: hover) {
    .band:hover :global(.strip--mini i[data-p]) {
      transition-duration: var(--d-m);
    }
    #ezvenda:hover :global(i[data-p='ezvenda']),
    #mini-havoc:hover :global(i[data-p='mini-havoc']),
    #gympaid:hover :global(i[data-p='gympaid']) {
      background: var(--signal);
    }
    .band:hover .phones :global(img),
    .band:hover .band__media--gympaid :global(img) {
      translate: 0 -6px;
    }
  }

  @media (min-width: 900px) {
    .band__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .band__text {
      grid-column: 1 / 6;
    }
    .band__media {
      grid-column: 7 / -1;
      order: 0;
    }
    .band--flip .band__text {
      grid-column: 8 / -1;
      grid-row: 1;
    }
    .band--flip .band__media {
      grid-column: 1 / 7;
      grid-row: 1;
    }
  }
</style>
