---
// Hero 5, Mercury Index: the work stands in a ring on a mirror floor; drag to turn it.
import { Image } from 'astro:assets';
import { hero, site } from '../../data/site';
import { posters } from '../../data/posters';
const cards = Object.values(posters);
---

<section class="hx" data-field="base" data-hero-variant="5" aria-labelledby="hx-name">
  <p class="hx__ghost display" aria-hidden="true">Malik Sohaib</p>
  <div class="wrap hx__top">
    <h1 class="hx__name display" id="hx-name">Malik<br />Sohaib</h1>
    <p class="hx__lede"><b>{hero.role}.</b> Idea to production, for companies, clients and products of my own.</p>
  </div>
  <div class="hx__stage" data-ring-stage>
    <div class="hx__ring" data-ring style={`--n: ${cards.length}`}>
      {
        cards.map((p, i) => (
          <div class="hx__slot" style={`--i: ${i}`}>
            <a class="hx__card" href={p.href} data-poster data-cursor="View" aria-label={`${p.title}: ${p.caption}`}>
              <span class="hx__art" data-liquid>
                <Image src={p.art} alt="" widths={[360, 720]} sizes="22vw" loading="lazy" />
              </span>
              <span class="hx__label">
                <b>{p.title}</b>
                <span>{p.kind}</span>
              </span>
            </a>
            <span class="hx__reflect" aria-hidden="true">
              <Image src={p.art} alt="" widths={[360]} sizes="22vw" loading="lazy" />
            </span>
          </div>
        ))
      }
    </div>
  </div>
  <div class="wrap hx__bottom">
    <div class="hx__actions">
      <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
      <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
    </div>
    <span class="hx__hint">⟵ Drag to turn ⟶</span>
  </div>
</section>

<style>
  .hx {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    background: radial-gradient(120% 60% at 50% 100%, color-mix(in srgb, var(--ink) 10%, var(--ground)) 0%, var(--ground) 65%);
  }
  .hx__ghost {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    z-index: 0;
    margin: 0;
    text-align: center;
    font-size: 15vw;
    line-height: 0.8;
    white-space: nowrap;
    color: color-mix(in srgb, var(--ink) 6%, transparent);
    pointer-events: none;
  }
  .hx__top {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 3rem;
    padding-top: 1.5rem;
  }
  .hx__name {
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.82;
  }
  .hx__lede {
    max-width: 28rem;
    color: var(--muted);
  }
  .hx__lede b {
    color: var(--ink);
  }
  /* The ring: cards stand on a circle around the viewer's axis, turned by --a. */
  .hx__stage {
    position: relative;
    z-index: 1;
    min-height: 26rem;
    perspective: 1100px;
    perspective-origin: 50% 30%;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .hx__stage.is-drag {
    cursor: grabbing;
  }
  .hx__ring {
    --a: 0deg;
    --r: clamp(220px, 26vw, 420px);
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1)) rotateY(var(--a));
  }
  .hx__slot {
    --w: clamp(130px, 13vw, 210px);
    position: absolute;
    left: calc(var(--w) / -2);
    top: calc(var(--w) * -0.8);
    width: var(--w);
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--r));
  }
  .hx__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: #ededE7;
    text-decoration: none;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .hx__art,
  .hx__art :global(img),
  .hx__art :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hx__art :global(canvas) {
    opacity: 0;
    transition: opacity 250ms linear;
  }
  .hx__label {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    display: grid;
    font-size: 11px;
    line-height: 1.25;
  }
  .hx__label b {
    font-family: var(--f-display);
    font-size: 1.9em;
    text-transform: uppercase;
    line-height: 0.9;
  }
  .hx__reflect {
    display: block;
    height: calc(var(--w) * 0.5);
    overflow: hidden;
    transform: scaleY(-1);
    opacity: 0.25;
    -webkit-mask-image: linear-gradient(to top, #000, transparent 80%);
    mask-image: linear-gradient(to top, #000, transparent 80%);
  }
  .hx__reflect :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    margin-top: calc(var(--w) * -0.75);
  }
  .hx__bottom {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 2rem;
  }
  .hx__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hx__hint {
    font-size: var(--t-s);
    font-weight: 600;
  }
</style>

<script>
  import { onPage } from '../../motion/start';
  import { onFrame } from '../../motion/clock';

  // Drag turns the ring with momentum; at rest it drifts slowly; a drag never counts as a click.
  onPage(() => {
    const stage = document.querySelector<HTMLElement>('[data-ring-stage]');
    const ring = stage?.querySelector<HTMLElement>('[data-ring]');
    if (!stage || !ring || !stage.offsetParent) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let angle = 0;
    let vel = 0;
    let drag: { x: number; a: number; moved: number } | null = null;
    let lastX = 0;
    const down = (e: PointerEvent) => {
      drag = { x: e.clientX, a: angle, moved: 0 };
      lastX = e.clientX;
      vel = 0;
      stage.classList.add('is-drag');
    };
    const move = (e: PointerEvent) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      drag.moved = Math.max(drag.moved, Math.abs(dx));
      angle = drag.a + dx * 0.25;
      vel = (e.clientX - lastX) * 0.25;
      lastX = e.clientX;
    };
    const up = () => {
      stage.classList.remove('is-drag');
      setTimeout(() => (drag = null), 0);
    };
    const click = (e: MouseEvent) => {
      if (drag && drag.moved > 6) {
        e.preventDefault();
        e.stopPropagation();
      }
    };
    stage.addEventListener('pointerdown', down);
    addEventListener('pointermove', move);
    addEventListener('pointerup', up);
    stage.addEventListener('click', click, true);
    let visible = true;
    const io = new IntersectionObserver(([e]) => (visible = e.isIntersecting));
    io.observe(stage);
    const stop = onFrame(() => {
      if (!visible) return;
      if (!drag) {
        vel *= 0.94;
        angle += vel + (reduce ? 0 : -0.06);
      }
      ring.style.setProperty('--a', `${angle}deg`);
    });
    return () => {
      stop();
      io.disconnect();
      stage.removeEventListener('pointerdown', down);
      removeEventListener('pointermove', move);
      removeEventListener('pointerup', up);
      stage.removeEventListener('click', click, true);
    };
  });
</script>
