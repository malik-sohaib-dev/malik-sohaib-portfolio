---
// Hero 4, the Mercury Stage: a stirrable mercury wallpaper, the work as a slide of posters along
// the bottom, and the introduction above it. While the introduction is being chosen there are
// three treatments, switched with ?top=a|b|c (A editorial, B one lens, C the sentence).
// Each one ties the services to the projects in the slide.
import { Image } from 'astro:assets';
import Poster from '../Poster.astro';
import { hero, site } from '../../data/site';
import { posters } from '../../data/posters';
import wallpaper from '../../assets/hero/mercury.webp';

const apps = ['ezvenda', 'mini-havoc', 'gympaid', 'photon-elixir-phoenix', 'arthur-vibe', 'bh-group'].map((s) => posters[s]);
// Each service points at the project that proves it.
const services = [
  { name: 'Products and web apps', short: 'products and web apps', example: 'EzVenda: a commerce platform, from the first commit to merchants trading on it.', slug: 'ezvenda' },
  { name: 'Real-time apps and games', short: 'real-time apps and games', example: 'Mini Havoc: 23 multiplayer games on a 30 Hz server, load-tested to 480 players.', slug: 'mini-havoc' },
  { name: 'AI agents and integrations', short: 'AI agents and integrations', example: 'Arthur Vibe: AI-led interviews with reports you can question.', slug: 'arthur-vibe' },
  { name: 'Tools for a business', short: 'tools for a business', example: 'GymPaid: renewals and WhatsApp reminders for a gym, built in two days.', slug: 'gympaid' },
];
const servicesJson = JSON.stringify(services.map(({ short, slug }) => ({ short, slug })));
---

<section class="hs" data-field="base" data-hero-variant="4" aria-labelledby="hs-name" data-stage>
  <h1 class="sr-only" id="hs-name">{site.name}, {hero.role.toLowerCase()}</h1>
  <div class="hs__wall" data-liquid="auto" aria-hidden="true">
    <Image src={wallpaper} alt="" widths={[800, 1280, 1920, 2400]} sizes="100vw" loading="eager" />
  </div>

  <!-- A · Editorial: the name on the mercury, a status line, and the services as an index. -->
  <div class="hs__top hs__top--a wrap" data-top-variant="a">
    <p class="hs__status"><span class="hs__dot" aria-hidden="true"></span>Open to new projects · Remote, worldwide</p>
    <div class="hsa__grid">
      <div class="hsa__intro">
        <p class="hsa__name display" aria-hidden="true">Malik<br />Sohaib</p>
        <p class="hsa__role">{hero.role}. Idea to production, for companies, clients and products of my own.</p>
        <div class="hs__actions">
          <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
          <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hsa__build">
        <h2 class="hsa__label">What I build</h2>
        <ol class="hsa__list">
          {
            services.map((sv, i) => (
              <li>
                <a class="hsa__row" href={posters[sv.slug].href} data-service={sv.slug}>
                  <span class="hsa__n num">0{i + 1}</span>
                  <span class="hsa__sname">{sv.name}</span>
                  <span class="hsa__ex">{sv.example}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>

  <!-- B · One lens: a single glass panel with three tabs. -->
  <div class="hs__top hs__top--b wrap" data-top-variant="b">
    <div class="hsb__lens" data-lens>
      <p class="hsb__name display" aria-hidden="true">Malik<br />Sohaib</p>
      <div class="hsb__tabs" role="tablist" aria-label="About Malik Sohaib">
        <button type="button" role="tab" aria-selected="true" aria-controls="hsb-about" id="hsb-t-about" data-tab="about">About</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="hsb-build" id="hsb-t-build" data-tab="build" tabindex="-1">What I build</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="hsb-now" id="hsb-t-now" data-tab="now" tabindex="-1">Now</button>
      </div>
      <div class="hsb__panel" role="tabpanel" id="hsb-about" aria-labelledby="hsb-t-about" data-panel="about">
        <p class="hsb__lede"><b>{hero.role}.</b> {hero.lede}</p>
      </div>
      <div class="hsb__panel" role="tabpanel" id="hsb-build" aria-labelledby="hsb-t-build" data-panel="build" hidden>
        <ul class="hsb__services">
          {services.map((sv) => (
            <li data-service={sv.slug}>
              <b>{sv.name}</b>
              <span>{sv.example}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hsb__panel" role="tabpanel" id="hsb-now" aria-labelledby="hsb-t-now" data-panel="now" hidden>
        <dl class="hsb__now">
          <div><dt>Open to</dt><dd>New projects, remote, worldwide</dd></div>
          <div><dt>Day job</dt><dd>Senior engineer, Arthur</dd></div>
          <div><dt>Building</dt><dd>EzVenda and Mini Havoc</dd></div>
          <div><dt>Shipping since</dt><dd>2022</dd></div>
        </dl>
      </div>
      <div class="hs__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>

  <!-- C · The sentence: one line that changes with the work. -->
  <div class="hs__top hs__top--c wrap" data-top-variant="c">
    <p class="hs__status"><span class="hs__dot" aria-hidden="true"></span>Open to new projects · Remote, worldwide</p>
    <p class="hsc__line" data-sentence data-services={servicesJson}>
      <span class="hsc__name display">Malik Sohaib</span>
      <span class="hsc__rest">builds <span class="hsc__swap" data-swap aria-live="polite"><span data-swap-text>{services[0].short}</span></span> for teams anywhere, from the idea to production.</span>
    </p>
    <div class="hs__actions">
      <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
      <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>

  <!-- The work, as a slide of posters along the bottom. -->
  <nav class="hs__dock" aria-label="Selected work" data-dock>
    {
      apps.map((p) => (
        <a class="hs__app" href={p.href} data-cursor="View" data-peek={p.slug}>
          <span class="hs__icon">
            <Image src={p.art} alt="" widths={[160, 240]} sizes="80px" loading="lazy" />
          </span>
          <span class="hs__label">{p.title}</span>
        </a>
      ))
    }
    <a class="hs__app hs__app--all" href="#work">
      <span class="hs__icon"><span>All</span></span>
      <span class="hs__label">All work</span>
    </a>
  </nav>
  <div class="hs__peek" data-peek-box aria-hidden="true">
    {
      apps.map((p) => (
        <div class="hs__peek-item" data-peek-for={p.slug}>
          <Poster poster={p} sizes="300px" decorative />
        </div>
      ))
    }
  </div>
</section>

<style>
  .hs {
    position: relative;
    height: calc(100svh - 4rem);
    min-height: 640px;
    overflow: hidden;
    color: #ededE7;
    background: #0b0b0b;
    --ink: #ededE7;
    --ground: #0b0b0b;
    --muted: #a9a9a3;
    --line: rgb(237 237 231 / 0.16);
  }
  .hs__wall,
  .hs__wall :global(img),
  .hs__wall :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hs__wall :global(canvas) {
    opacity: 0;
    transition: opacity 300ms linear;
  }
  /* A soft shade, so type over the mercury always reads. */
  .hs__wall::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 18% 45%, rgb(0 0 0 / 0.55), transparent 70%), linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 35%);
    pointer-events: none;
  }
  @keyframes drift {
    to {
      transform: scale(1.08) translate(-1.5%, 1%);
    }
  }
  :global(html.motion:not(.liquid-on)) .hs__wall :global(img) {
    animation: drift 18s ease-in-out infinite alternate;
  }

  /* Only the chosen introduction shows. */
  .hs__top {
    position: relative;
    z-index: 2;
    display: none;
    height: calc(100% - 7.5rem);
    pointer-events: none;
  }
  .hs__top > * {
    pointer-events: auto;
  }
  :global(html:not([data-top])) .hs__top--a,
  :global(html[data-top='a']) .hs__top--a,
  :global(html[data-top='b']) .hs__top--b,
  :global(html[data-top='c']) .hs__top--c {
    display: grid;
  }
  .hs__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--t-s);
    font-weight: 600;
  }
  .hs__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ededE7;
    animation: pulse 2.2s ease-out infinite;
  }
  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 rgb(237 237 231 / 0.6);
    }
    to {
      box-shadow: 0 0 0 9px rgb(237 237 231 / 0);
    }
  }
  .hs__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* A */
  .hs__top--a {
    grid-template-rows: auto 1fr;
    padding-top: 1.75rem;
  }
  .hsa__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
    padding-bottom: 2rem;
  }
  .hsa__intro {
    grid-column: 1 / 8;
    display: grid;
    gap: 1.25rem;
  }
  .hsa__name {
    font-size: clamp(4rem, 13vw, 12.5rem);
    line-height: 0.8;
    margin-left: -0.04em;
  }
  .hsa__role {
    max-width: 30rem;
    font-size: 1.15rem;
    line-height: 1.45;
    color: #c9c9c3;
  }
  .hsa__build {
    grid-column: 9 / -1;
  }
  .hsa__label {
    margin-bottom: 0.6rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #a9a9a3;
  }
  .hsa__list {
    border-top: 1px solid var(--line);
  }
  .hsa__row {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0 0.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .hsa__n {
    color: #8f8f89;
    padding-top: 0.15rem;
  }
  .hsa__sname {
    font-weight: 600;
    font-size: 1.1rem;
    transition: translate var(--d-m) var(--ease);
  }
  /* A row's example opens while it is pointed at or focused. */
  .hsa__ex {
    grid-column: 2;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    font-size: var(--t-s);
    color: #b9b9b3;
    transition:
      max-height var(--d-m) var(--ease),
      opacity var(--d-m) var(--ease),
      margin var(--d-m) var(--ease);
  }
  .hsa__row:hover .hsa__ex,
  .hsa__row:focus-visible .hsa__ex,
  .hsa__row.is-on .hsa__ex {
    max-height: 4.5em;
    opacity: 1;
    margin-top: 0.3rem;
  }
  .hsa__row:hover .hsa__sname,
  .hsa__row:focus-visible .hsa__sname,
  .hsa__row.is-on .hsa__sname {
    translate: 0.35rem 0;
  }

  /* B */
  .hs__top--b {
    align-items: center;
  }
  .hsb__lens {
    width: min(34rem, 100%);
    display: grid;
    gap: 1.1rem;
    padding: 2rem 2rem 1.75rem;
    border-radius: 28px;
    background: rgb(14 14 14 / 0.42);
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      inset 0 -30px 60px rgb(255 255 255 / 0.04),
      0 40px 100px rgb(0 0 0 / 0.5);
  }
  .hsb__name {
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 0.82;
  }
  .hsb__tabs {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    justify-self: start;
  }
  .hsb__tabs button {
    min-height: 36px;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: #b9b9b3;
    font-weight: 600;
    font-size: var(--t-s);
    cursor: pointer;
    transition:
      background-color var(--d-s) var(--ease),
      color var(--d-s) var(--ease);
  }
  .hsb__tabs button[aria-selected='true'] {
    background: #ededE7;
    color: #0b0b0b;
  }
  .hsb__panel {
    min-height: 7.5rem;
  }
  .hsb__lede {
    color: #c9c9c3;
    line-height: 1.5;
  }
  .hsb__lede b {
    color: #ededE7;
  }
  .hsb__services {
    display: grid;
    gap: 0.55rem;
    font-size: var(--t-s);
  }
  .hsb__services li {
    display: grid;
  }
  .hsb__services span {
    color: #a9a9a3;
  }
  .hsb__now {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    font-size: var(--t-s);
  }
  .hsb__now dt {
    color: #8f8f89;
  }
  .hsb__now dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }

  /* C */
  .hs__top--c {
    align-content: center;
    gap: 2rem;
  }
  .hsc__line {
    max-width: 22ch;
    font-size: clamp(2.25rem, 1rem + 4.4vw, 5.25rem);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .hsc__name {
    display: block;
    font-size: 1.35em;
    line-height: 0.85;
    margin-bottom: 0.15em;
  }
  .hsc__rest {
    color: #c9c9c3;
  }
  .hsc__swap {
    display: inline-block;
    color: #ededE7;
    background: linear-gradient(180deg, #ffffff 0%, #d9d9d3 40%, #7a7a75 55%, #f0f0ea 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
  }
  .hsc__swap span {
    display: inline-block;
    transition:
      opacity 300ms var(--ease),
      translate 500ms var(--ease),
      filter 300ms var(--ease);
  }
  .hsc__swap.is-out span {
    opacity: 0;
    translate: 0 -0.3em;
    filter: blur(6px);
  }

  /* The slide of work */
  .hs__dock {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    z-index: 4;
    translate: -50% 0;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 10px 12px;
    background: rgb(14 14 14 / 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 20px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
  .hs__app {
    position: relative;
    flex: none;
    width: 60px;
    text-decoration: none;
    transform-origin: 50% 100%;
    transition: scale 180ms var(--ease);
  }
  .hs__icon {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 14px;
    overflow: hidden;
    background: #161616;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    transition: box-shadow var(--d-s) var(--ease);
  }
  .hs__icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .hs__app.is-lit .hs__icon {
    box-shadow:
      inset 0 0 0 2px #ededE7,
      0 0 24px rgb(255 255 255 / 0.25);
  }
  .hs__app--all .hs__icon span {
    font-weight: 600;
    font-size: 0.8rem;
  }
  .hs__label {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 4px;
    white-space: nowrap;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgb(14 14 14 / 0.85);
    font-size: 11px;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--d-s) var(--ease),
      translate var(--d-s) var(--ease);
  }
  .hs__app--all:hover .hs__label,
  .hs__app:focus-visible .hs__label {
    opacity: 1;
    translate: -50% 0;
  }
  .hs__peek {
    position: absolute;
    left: 0;
    bottom: 7.4rem;
    z-index: 5;
    width: 17rem;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    opacity: 0;
    translate: var(--px, 0) 16px;
    scale: 0.92;
    transform-origin: 50% 100%;
    transition:
      opacity 260ms var(--ease),
      scale 420ms var(--ease),
      translate 420ms var(--ease);
    filter: drop-shadow(0 30px 50px rgb(0 0 0 / 0.6));
  }
  .hs__peek.is-on {
    opacity: 1;
    scale: 1;
    translate: var(--px, 0) 0;
  }
  .hs__peek-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 200ms linear;
  }
  .hs__peek-item.is-on {
    opacity: 1;
  }

  /* Phones: the introduction stacks, the slide becomes a row of posters you swipe. */
  @media (max-width: 899px) {
    .hs__wall::after {
      background: linear-gradient(to bottom, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.5) 60%, rgb(0 0 0 / 0.7));
    }
    .hs {
      height: auto;
      min-height: calc(100svh - 4rem);
      display: flex;
      flex-direction: column;
    }
    .hs__top {
      height: auto;
      padding-block: 1.5rem 1rem;
    }
    .hsa__grid {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
      padding-bottom: 0;
    }
    .hsa__intro,
    .hsa__build {
      grid-column: 1;
    }
    .hsa__name {
      font-size: clamp(3.75rem, 21vw, 6rem);
    }
    .hsb__lens {
      padding: 1.5rem 1.25rem;
    }
    .hsb__tabs button {
      padding: 0 0.75rem;
    }
    .hs__peek {
      display: none;
    }
    .hs__dock {
      position: relative;
      left: auto;
      bottom: auto;
      translate: none;
      margin: auto 0 1rem;
      padding: 0 var(--margin);
      gap: 12px;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      box-shadow: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hs__app {
      width: 38vw;
      scroll-snap-align: start;
      display: grid;
      gap: 6px;
    }
    .hs__icon {
      aspect-ratio: 4 / 5;
      border-radius: 12px;
    }
    .hs__label {
      position: static;
      translate: none;
      opacity: 1;
      padding: 0;
      background: none;
      font-size: 12px;
    }
  }
</style>

<script>
  import { onPage } from '../../motion/start';

  onPage(() => {
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (!stage || !stage.offsetParent) return;
    const offs: (() => void)[] = [];
    const desktop = () => matchMedia('(min-width: 900px)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dock = stage.querySelector<HTMLElement>('[data-dock]')!;
    const apps = [...dock.querySelectorAll<HTMLElement>('.hs__app')];
    const peek = stage.querySelector<HTMLElement>('[data-peek-box]')!;
    const items = [...peek.querySelectorAll<HTMLElement>('[data-peek-for]')];

    // Light a project in the slide, and lift its poster over it.
    // The big peek only rises when the slide itself is pointed at; elsewhere the icon just lights.
    const show = (slug: string | null, x?: number, lift = false) => {
      apps.forEach((a) => a.classList.toggle('is-lit', !!slug && a.dataset.peek === slug));
      if (!slug || !lift || !desktop()) return peek.classList.remove('is-on');
      items.forEach((it) => it.classList.toggle('is-on', it.dataset.peekFor === slug));
      const o = stage.getBoundingClientRect();
      const app = apps.find((a) => a.dataset.peek === slug)!;
      const r = app.getBoundingClientRect();
      const w = peek.offsetWidth;
      const cx = x ?? r.left + r.width / 2;
      peek.style.setProperty('--px', `${Math.max(16, Math.min(o.width - w - 16, cx - o.left - w / 2))}px`);
      peek.classList.add('is-on');
    };

    // The slide magnifies near the pointer and peeks the hovered poster.
    const over = (e: PointerEvent) => {
      if (!desktop() || e.pointerType !== 'mouse') return;
      for (const a of apps) {
        const r = a.getBoundingClientRect();
        const d = Math.abs(e.clientX - (r.left + r.width / 2));
        a.style.scale = String(1 + 0.45 * Math.max(0, 1 - d / 130));
      }
      const app = (e.target as HTMLElement).closest<HTMLElement>('[data-peek]');
      show(app?.dataset.peek ?? null, e.clientX, true);
      if (app) sentenceTo(app.dataset.peek!);
    };
    const rest = () => {
      apps.forEach((a) => (a.style.scale = '1'));
      show(null);
    };
    dock.addEventListener('pointermove', over);
    dock.addEventListener('pointerleave', rest);
    offs.push(() => {
      dock.removeEventListener('pointermove', over);
      dock.removeEventListener('pointerleave', rest);
    });

    // A: a service row lights the project that proves it.
    const rows = [...stage.querySelectorAll<HTMLElement>('.hsa__row')];
    const onRow = (e: Event) => {
      const row = e.currentTarget as HTMLElement;
      const on = e.type === 'pointerenter' || e.type === 'focus';
      rows.forEach((r) => r.classList.toggle('is-on', on && r === row));
      show(on ? row.dataset.service! : null);
    };
    rows.forEach((r) => ['pointerenter', 'pointerleave', 'focus', 'blur'].forEach((t) => r.addEventListener(t, onRow)));
    offs.push(() => rows.forEach((r) => ['pointerenter', 'pointerleave', 'focus', 'blur'].forEach((t) => r.removeEventListener(t, onRow))));

    // B: tabs, with arrow keys between them.
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const pick = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        stage.querySelector<HTMLElement>(`[data-panel="${t.dataset.tab}"]`)!.hidden = !on;
      });
    };
    const onTab = (e: Event) => pick(e.currentTarget as HTMLButtonElement);
    const onTabKey = (e: KeyboardEvent) => {
      const i = tabs.indexOf(e.currentTarget as HTMLButtonElement);
      const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
      if (j === null) return;
      const t = tabs[(j + tabs.length) % tabs.length];
      pick(t);
      t.focus();
    };
    tabs.forEach((t) => {
      t.addEventListener('click', onTab);
      t.addEventListener('keydown', onTabKey);
    });
    offs.push(() => tabs.forEach((t) => (t.removeEventListener('click', onTab), t.removeEventListener('keydown', onTabKey))));
    const svcs = [...stage.querySelectorAll<HTMLElement>('.hsb__services [data-service]')];
    const onSvc = (e: Event) => show(e.type === 'pointerenter' ? (e.currentTarget as HTMLElement).dataset.service! : null);
    svcs.forEach((s) => (s.addEventListener('pointerenter', onSvc), s.addEventListener('pointerleave', onSvc)));
    offs.push(() => svcs.forEach((s) => (s.removeEventListener('pointerenter', onSvc), s.removeEventListener('pointerleave', onSvc))));

    // C: the sentence cycles the services, and follows the slide when you point at a project.
    const line = stage.querySelector<HTMLElement>('[data-sentence]');
    const swap = line?.querySelector<HTMLElement>('[data-swap]');
    const text = line?.querySelector<HTMLElement>('[data-swap-text]');
    const list: { short: string; slug: string }[] = line ? JSON.parse(line.dataset.services!) : [];
    let idx = 0;
    let timer = 0;
    function sentenceTo(slug: string) {
      if (!line?.offsetParent) return;
      const j = list.findIndex((s) => s.slug === slug);
      if (j >= 0 && j !== idx) setIdx(j, false);
    }
    const setIdx = (j: number, auto: boolean) => {
      idx = j;
      swap!.classList.add('is-out');
      setTimeout(() => {
        text!.textContent = list[idx].short;
        swap!.classList.remove('is-out');
        if (auto) show(list[idx].slug);
      }, reduce ? 0 : 280);
    };
    if (line?.offsetParent && !reduce) {
      const cycle = () => {
        if (!dock.matches(':hover')) setIdx((idx + 1) % list.length, true);
        timer = window.setTimeout(cycle, 3200);
      };
      timer = window.setTimeout(cycle, 3200);
      show(list[0].slug);
    }
    offs.push(() => clearTimeout(timer));
    return () => offs.forEach((o) => o());
  });
</script>
