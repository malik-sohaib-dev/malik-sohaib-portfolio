---
// Hero 1, Mercury Glyph: the O of SOHAIB is a chrome object that keeps pouring into a new shape.
import { Image } from 'astro:assets';
import { hero, site } from '../../data/site';
import ring from '../../assets/hero/torus.webp';
import bean from '../../assets/hero/bean.webp';
import ico from '../../assets/hero/ico-chrome.webp';
const shapes = [ring, bean, ico];
---

<section class="hg" data-field="base" data-hero-variant="1" aria-labelledby="hg-name">
  <div class="wrap hg__in">
    <h1 class="hg__name display" id="hg-name" data-glyph-name>
      <span class="hg__malik">Malik</span>
      <span class="hg__row" aria-hidden="true">
        <span>S</span>
        <span class="hg__o" data-glyph>
          {shapes.map((s, i) => <Image class:list={['hg__shape', { 'is-on': i === 0 }]} src={s} alt="" widths={[320, 640]} sizes="30vw" loading={i === 0 ? 'eager' : 'lazy'} />)}
        </span>
        <span>haib</span>
      </span>
      <span class="sr-only">Sohaib, {hero.role.toLowerCase()}</span>
    </h1>
    <div class="hg__pitch">
      <p class="hg__role display">{hero.role}</p>
      <p class="hg__lede">{hero.lede}</p>
      <div class="hg__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
    <dl class="hg__facts">
      {
        hero.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class="display">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hg__in {
    display: grid;
    gap: 2rem var(--gutter);
    min-height: calc(100svh - 4rem);
    align-content: space-between;
    padding-block: 2rem 2.5rem;
  }
  .hg__name {
    display: grid;
    justify-items: center;
    margin: 0;
    container-type: inline-size;
  }
  .hg__malik {
    font-size: min(9cqi, 14svh);
    line-height: 0.8;
    letter-spacing: 0.02em;
  }
  .hg__row {
    display: flex;
    align-items: center;
    font-size: min(30cqi, 44svh);
    line-height: 0.8;
  }
  /* The O: a square slot at cap height, holding the shapes stacked. */
  .hg__o {
    position: relative;
    width: 0.66em;
    height: 0.66em;
    margin: 0 0.04em;
    perspective: 600px;
  }
  .hg__o :global(.hg__shape) {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    object-fit: contain;
    opacity: 0;
    scale: 0.6;
    filter: blur(14px);
    transition:
      opacity 700ms var(--ease),
      scale 900ms cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 700ms var(--ease);
  }
  .hg__o :global(.hg__shape.is-on) {
    opacity: 1;
    scale: 1;
    filter: blur(0);
  }
  .hg__o :global(.hg__shape.is-off) {
    scale: 1.35;
    filter: blur(18px);
  }
  .hg__role {
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.25rem);
    line-height: 0.9;
  }
  .hg__lede {
    max-width: 34rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }
  .hg__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .hg__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    font-size: var(--t-s);
  }
  .hg__facts dt {
    color: var(--muted);
  }
  .hg__facts dd {
    margin: 0.3rem 0 0;
    font-size: 1.6rem;
    text-transform: none;
  }
  @media (min-width: 900px) {
    .hg__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .hg__name {
      grid-column: 1 / -1;
    }
    .hg__pitch {
      grid-column: 1 / 7;
      align-self: end;
    }
    .hg__facts {
      grid-column: 8 / -1;
      align-self: end;
    }
  }
</style>

<script>
  import { onPage } from '../../motion/start';
  import { onFrame } from '../../motion/clock';

  // Pour the next shape into the O on a loop, faster while the name is hovered; tilt it to the pointer.
  onPage(() => {
    const slot = document.querySelector<HTMLElement>('[data-glyph]');
    const name = document.querySelector<HTMLElement>('[data-glyph-name]');
    if (!slot || !name || !slot.offsetParent) return;
    const shapes = [...slot.querySelectorAll<HTMLElement>('.hg__shape')];
    let i = 0;
    let timer = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const next = () => {
      shapes[i].classList.replace('is-on', 'is-off');
      const out = shapes[i];
      setTimeout(() => out.classList.remove('is-off'), 900);
      i = (i + 1) % shapes.length;
      shapes[i].classList.add('is-on');
      timer = window.setTimeout(next, name.matches(':hover') ? 900 : 2600);
    };
    if (!reduce) timer = window.setTimeout(next, 2600);

    const aim = { x: 0, y: 0 };
    const cur = { x: 0, y: 0 };
    const move = (e: PointerEvent) => {
      aim.x = e.clientX / innerWidth - 0.5;
      aim.y = e.clientY / innerHeight - 0.5;
    };
    addEventListener('pointermove', move, { passive: true });
    const stop = reduce
      ? () => {}
      : onFrame(() => {
          cur.x += (aim.x - cur.x) * 0.08;
          cur.y += (aim.y - cur.y) * 0.08;
          slot.style.transform = `rotateY(${cur.x * 40}deg) rotateX(${-cur.y * 30}deg)`;
        });
    return () => {
      clearTimeout(timer);
      stop();
      removeEventListener('pointermove', move);
    };
  });
</script>
