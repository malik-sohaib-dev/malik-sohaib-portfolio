---
// Hero 2, Render Brush: an engineer's wireframe that the pointer pours chrome into.
import { getImage } from 'astro:assets';
import { hero, site } from '../../data/site';
import wireSrc from '../../assets/hero/ico-wire.webp';
import chromeSrc from '../../assets/hero/ico-chrome.webp';
const wire = await getImage({ src: wireSrc, width: 1200, format: 'webp' });
const chrome = await getImage({ src: chromeSrc, width: 1200, format: 'webp' });
---

<section class="hb" data-field="base" data-hero-variant="2" aria-labelledby="hb-name">
  <div class="wrap hb__in">
    <dl class="hb__spec">
      <div><dt>Now</dt><dd>Senior engineer, Arthur</dd></div>
      <div><dt>Own products</dt><dd>EzVenda, Mini Havoc, GymPaid</dd></div>
      <div><dt>Shipping since</dt><dd>2022, remote</dd></div>
      <div><dt>Works on</dt><dd>Web apps, real-time, AI agents</dd></div>
    </dl>
    <div class="hb__stage" data-brush data-wire={wire.src} data-chrome={chrome.src} aria-hidden="true">
      <canvas></canvas>
      <span class="hb__hint">Move across it to pour chrome in</span>
    </div>
    <div class="hb__copy">
      <h1 class="hb__name display" id="hb-name">Malik<br />Sohaib</h1>
      <p class="hb__lede">Built like an engineer, finished like a product. {hero.lede}</p>
      <div class="hb__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href="#work">See the work <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hb__in {
    position: relative;
    display: grid;
    gap: 1.5rem var(--gutter);
    min-height: calc(100svh - 4rem);
    padding-block: 1rem 2.5rem;
    grid-template-rows: auto 1fr auto;
  }
  .hb__spec {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-xs);
  }
  .hb__spec dt {
    color: var(--muted);
  }
  .hb__spec dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
  }
  .hb__stage {
    position: relative;
    min-height: 40svh;
    touch-action: pan-y;
  }
  .hb__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hb__hint {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .hb__name {
    font-size: clamp(4rem, 15vw, 11rem);
    line-height: 0.8;
    margin-left: -0.04em;
  }
  .hb__lede {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .hb__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 900px) {
    .hb__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
    }
    .hb__spec {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .hb__stage {
      grid-column: 5 / -1;
      grid-row: 2;
    }
    .hb__copy {
      grid-column: 1 / 7;
      grid-row: 2;
      align-self: end;
      position: relative;
      z-index: 1;
    }
  }
</style>

<script>
  import { onPage } from '../../motion/start';
  import { onFrame } from '../../motion/clock';

  // A trail mask: the pointer stamps soft discs into it, it fades over a few seconds, and the
  // chrome render shows through it over the wireframe. When idle, a ghost stroke keeps painting.
  onPage(() => {
    const stage = document.querySelector<HTMLElement>('[data-brush]');
    if (!stage || !stage.offsetParent) return;
    const canvas = stage.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const trail = document.createElement('canvas');
    const tctx = trail.getContext('2d')!;
    const layer = document.createElement('canvas');
    const lctx = layer.getContext('2d')!;
    const load = (src: string) => new Promise<HTMLImageElement>((r) => { const i = new Image(); i.onload = () => r(i); i.src = src; });
    let wire: HTMLImageElement | null = null;
    let chrome: HTMLImageElement | null = null;
    Promise.all([load(stage.dataset.wire!), load(stage.dataset.chrome!)]).then(([w, c]) => { wire = w; chrome = c; });

    let W = 0, H = 0, box = { x: 0, y: 0, s: 0 };
    const size = () => {
      const r = stage.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio, 2);
      W = canvas.width = trail.width = layer.width = Math.round(r.width * dpr);
      H = canvas.height = trail.height = layer.height = Math.round(r.height * dpr);
      const s = Math.min(W, H) * 1.02;
      box = { x: (W - s) / 2, y: (H - s) / 2, s };
    };
    size();
    addEventListener('resize', size);

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let last: { x: number; y: number } | null = null;
    let lastMove = 0;
    const stamp = (x: number, y: number) => {
      const r = box.s * 0.16;
      const from = last ?? { x, y };
      const steps = Math.max(1, Math.ceil(Math.hypot(x - from.x, y - from.y) / (r * 0.35)));
      for (let k = 1; k <= steps; k++) {
        const px = from.x + ((x - from.x) * k) / steps;
        const py = from.y + ((y - from.y) * k) / steps;
        const g = tctx.createRadialGradient(px, py, 0, px, py, r);
        g.addColorStop(0, 'rgba(0,0,0,0.9)');
        g.addColorStop(1, 'rgba(0,0,0,0)');
        tctx.fillStyle = g;
        tctx.fillRect(px - r, py - r, r * 2, r * 2);
      }
      last = { x, y };
    };
    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      const dpr = W / r.width;
      stamp((e.clientX - r.left) * dpr, (e.clientY - r.top) * dpr);
      lastMove = performance.now();
    };
    const onLeave = () => (last = null);
    stage.addEventListener('pointermove', onMove);
    stage.addEventListener('pointerleave', onLeave);

    let visible = true;
    const io = new IntersectionObserver(([e]) => (visible = e.isIntersecting));
    io.observe(stage);
    let t0 = 0;
    const stop = onFrame((now) => {
      if (!visible || !wire || !chrome) return;
      t0 ||= now;
      const t = (now - t0) / 1000;
      // The ghost stroke, while nobody is pointing.
      if (!reduce && now - lastMove > 1200) {
        const gx = box.x + box.s * (0.5 + 0.3 * Math.cos(t * 0.9) * Math.sin(t * 0.37));
        const gy = box.y + box.s * (0.5 + 0.28 * Math.sin(t * 1.3));
        stamp(gx, gy);
      }
      // Let the chrome drain back to wire.
      tctx.globalCompositeOperation = 'destination-out';
      tctx.fillStyle = 'rgba(0,0,0,0.012)';
      tctx.fillRect(0, 0, W, H);
      tctx.globalCompositeOperation = 'source-over';
      // A slow float so the object breathes.
      const fy = reduce ? 0 : Math.sin(t * 0.8) * box.s * 0.012;
      ctx.clearRect(0, 0, W, H);
      ctx.globalAlpha = 0.55;
      ctx.drawImage(wire, box.x, box.y + fy, box.s, box.s);
      ctx.globalAlpha = 1;
      lctx.globalCompositeOperation = 'source-over';
      lctx.clearRect(0, 0, W, H);
      lctx.drawImage(chrome, box.x, box.y + fy, box.s, box.s);
      lctx.globalCompositeOperation = 'destination-in';
      lctx.drawImage(trail, 0, 0);
      ctx.drawImage(layer, 0, 0);
    });
    return () => {
      stop();
      io.disconnect();
      removeEventListener('resize', size);
      stage.removeEventListener('pointermove', onMove);
      stage.removeEventListener('pointerleave', onLeave);
    };
  });
</script>
