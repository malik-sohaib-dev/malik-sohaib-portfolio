---
// The hero: the name poured in liquid chrome (art/blender/poster.py, hero-wide / hero-tall), with
// liquid glass drifting through it and following the pointer (src/motion/liquid.ts). The name is
// real text in the h1; the render is its picture.
import { getImage } from 'astro:assets';
import { hero, site } from '../data/site';
import wideDark from '../assets/posters/hero-wide-dark.webp';
import tallDark from '../assets/posters/hero-tall-dark.webp';
import wideLight from '../assets/posters/hero-wide-light.webp';
import tallLight from '../assets/posters/hero-tall-light.webp';

// One art-directed picture per palette: wide on desktop, tall on phones.
const art = async (wide: ImageMetadata, tall: ImageMetadata) => {
  const w = await Promise.all([1280, 1920, 2400].map((width) => getImage({ src: wide, width, format: 'webp' })));
  const t = await Promise.all([720, 1080].map((width) => getImage({ src: tall, width, format: 'webp' })));
  return {
    wide: w.map((i, k) => `${i.src} ${[1280, 1920, 2400][k]}w`).join(', '),
    tall: t.map((i, k) => `${i.src} ${[720, 1080][k]}w`).join(', '),
    src: w[1].src,
  };
};
const pictures = { studio: await art(wideDark, tallDark), gallery: await art(wideLight, tallLight) };
---

<section class="hero" data-field="base" aria-labelledby="hero-name">
  {
    (['studio', 'gallery'] as const).map((p) => (
      <div class:list={['hero__art', `hero__art--${p}`]} data-liquid="auto" aria-hidden="true">
        <picture>
          <source media="(max-width: 899px)" srcset={pictures[p].tall} sizes="100vw" />
          <img src={pictures[p].src} srcset={pictures[p].wide} sizes="100vw" alt="" fetchpriority={p === site.palette ? 'high' : 'low'} decoding="async" />
        </picture>
      </div>
    ))
  }
  <div class="wrap hero__in">
    <h1 class="sr-only" id="hero-name">{site.name}, {hero.role.toLowerCase()}</h1>
    <div class="hero__pitch">
      <p class="hero__role display">{hero.role}</p>
      <p class="hero__lede">{hero.lede}</p>
      <div class="hero__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="hero__more ul" href="/about">More about me</a>
      </div>
    </div>
    <dl class="hero__facts">
      {
        hero.facts.map((f) => (
          <div class="fact">
            <dt class="fact__label">{f.label}</dt>
            <dd class="fact__value display">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* Two rows: the chrome name on top, filling what the copy leaves; the copy beneath. */
  .hero {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: grid;
    grid-template-rows: minmax(46svh, 1fr) auto;
    overflow: clip;
  }
  .hero__art {
    position: relative;
    grid-row: 1;
    grid-column: 1;
  }
  .hero__art :global(img),
  .hero__art :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }
  .hero__art :global(canvas) {
    opacity: 0;
    transition: opacity 300ms linear;
  }
  /* Only the active palette's picture is shown (and so observed by the glass). */
  :global(html[data-palette='studio']) .hero__art--gallery,
  :global(html[data-palette='gallery']) .hero__art--studio {
    display: none;
  }
  /* The mirror floor fades into the ground, so the picture has no bottom edge. */
  .hero__art::after {
    content: '';
    position: absolute;
    inset: 62% 0 0;
    background: linear-gradient(to top, var(--ground), transparent);
    pointer-events: none;
  }
  .hero__in {
    position: relative;
    z-index: 1;
    /* Empty space passes the pointer through to the glass; the copy itself catches it. */
    pointer-events: none;
    grid-row: 2;
    display: grid;
    gap: 2rem var(--gutter);
    margin-top: -3rem;
    padding-block: 0 2rem;
  }
  .hero__in > * {
    pointer-events: auto;
  }
  .hero__role {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.25rem);
    line-height: 0.9;
  }
  .hero__lede {
    max-width: 36rem;
    margin-top: 1rem;
    line-height: 1.45;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
  .hero__more {
    font-weight: 600;
    font-size: var(--t-s);
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }
  .hero__facts {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .fact {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .fact__value {
    order: -1;
    font-size: 1.75rem;
    text-transform: none;
  }
  .fact__label {
    font-size: var(--t-s);
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      padding-block: 0 2.5rem;
    }
    .hero__pitch {
      grid-column: 1 / 7;
    }
    .hero__facts {
      grid-column: 8 / -1;
    }
    .hero__lede {
      font-size: 1.2rem;
    }
  }

  /* Intro, after the loader: the picture settles from a soft blur, then the copy rises. */
  @keyframes settle {
    from {
      opacity: 0;
      scale: 1.06;
      filter: blur(14px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }
  :global(html.motion:not(.is-ready)) .hero__art,
  :global(html.motion:not(.is-ready)) .hero__pitch,
  :global(html.motion:not(.is-ready)) .hero__facts {
    opacity: 0;
  }
  :global(html.motion.is-ready) .hero__art {
    animation: settle 1400ms var(--ease) both;
  }
  :global(html.motion.is-ready) .hero__pitch {
    animation: rise var(--d-l) var(--ease) 350ms both;
  }
  :global(html.motion.is-ready) .hero__facts {
    animation: rise var(--d-l) var(--ease) 450ms both;
  }
</style>
