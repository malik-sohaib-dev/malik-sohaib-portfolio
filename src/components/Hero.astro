---
import Strip from './Strip.astro';
import { commitData, hero, site } from '../data/site';

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__in">
    <h1 class="hero__title display" id="hero-title">
      <span class="hero__line"><span>I build</span></span>
      <span class="hero__line"><span>whole</span></span>
      <span class="hero__line"><span>products.</span></span>
    </h1>
    <div class="hero__side">
      <p class="hero__lede">{hero.lede}</p>
      <div class="hero__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero__data">
      <p class="hero__count">
        <span class="hero__num num" data-counter>{commitData.total.toLocaleString('en-US')}</span>
        <span class="hero__cap">commits from {fmt(commitData.from)} to {fmt(commitData.to)}, {hero.stripCaption}</span>
      </p>
      <Strip variant="hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
  }
  /* Phones: title, then the strip, so the signature is on the first screen; the pitch follows. */
  .hero__in {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-content: start;
    padding-block: 1.25rem 3rem;
    row-gap: 1.5rem;
  }
  .hero__title {
    grid-column: 1 / -1;
    /* Sized to the container so "PRODUCTS." spans the measure on a phone. */
    font-size: clamp(3.5rem, 22.5cqi, 16rem);
    margin-left: -0.045em;
  }
  .hero__line {
    display: block;
    /* Mask for the intro, with room for the descender-free caps to overshoot. */
    clip-path: inset(-0.1em -0.1em 0 -0.1em);
  }
  .hero__line > span {
    display: block;
  }
  .hero__side {
    grid-column: 1 / -1;
    order: 2;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .hero__lede {
    max-width: 34ch;
    line-height: 1.45;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__data {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.5rem;
  }
  .hero__count {
    display: flex;
    align-items: end;
    gap: 0.9rem;
  }
  .hero__num {
    font-size: clamp(2.75rem, 11cqi, 7rem);
    min-width: 4.2ch;
  }
  .hero__cap {
    max-width: 30ch;
    padding-bottom: 0.35rem;
    font-size: var(--t-xs);
    line-height: 1.35;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
    }
    .hero__in {
      grid-template-rows: 1fr auto;
      align-content: space-between;
      min-height: calc(100svh - 4rem);
      padding-block: clamp(1.5rem, 4vh, 3rem) clamp(1.5rem, 4vh, 2.5rem);
      row-gap: clamp(1.5rem, 4vh, 3rem);
    }
    .hero__side {
      order: 0;
    }
    .hero__title {
      /* Three lines, capped by height so the strip always makes the first screen. */
      font-size: min(12.5cqi, 20svh);
      grid-column: 1 / 9;
      align-self: start;
    }
    .hero__side {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: end;
    }
    .hero__lede {
      font-size: var(--t-m);
      line-height: 1.35;
    }
    .hero__data {
      grid-row: 2;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .hero__cap {
      font-size: var(--t-s);
    }
    .hero__count {
      grid-column: 1 / 3;
      flex-direction: column;
      align-items: start;
      gap: 0.5rem;
      padding-bottom: 1.6rem;
    }
    .hero__data :global(.strip) {
      grid-column: 3 / -1;
    }
  }

  /* Intro: the title lines rise under a mask, then the side copy. */
  @keyframes rise {
    from {
      translate: 0 100%;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }
  :global(html.motion) .hero__line > span {
    animation: rise var(--d-l) var(--ease) both;
  }
  :global(html.motion) .hero__line:nth-child(2) > span {
    animation-delay: 60ms;
  }
  :global(html.motion) .hero__line:nth-child(3) > span {
    animation-delay: 120ms;
  }
  :global(html.motion) .hero__side {
    animation: fade var(--d-m) var(--ease) 300ms both;
  }
</style>
