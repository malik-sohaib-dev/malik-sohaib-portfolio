---
import { hero, site } from '../data/site';
const [first, last] = site.name.split(' ');
---

<section class="hero" data-field="paper" aria-labelledby="hero-name">
  <div class="wrap hero__in">
    <h1 class="hero__name display" id="hero-name">
      <span class="hero__line"><span>{first}</span></span>
      <span class="hero__line"><span>{last}</span></span>
      <span class="sr-only">, {hero.role}</span>
    </h1>

    <!-- placeholder: the owner's portrait goes here (4:5). -->
    <figure class="hero__portrait" data-placeholder>
      <div class="hero__portrait-slot" role="img" aria-label="Portrait of Sohaib Malik, coming soon">
        <span>Portrait</span>
      </div>
    </figure>

    <div class="hero__pitch">
      <p class="hero__role display" aria-hidden="true">{hero.role}</p>
      <p class="hero__lede">{hero.lede}</p>
      <div class="hero__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={site.whatsapp.href} rel="noopener">WhatsApp <span class="btn__arrow" aria-hidden="true">↗</span></a>
        <a class="hero__more ul" href="/about">More about me</a>
      </div>
    </div>

    <dl class="hero__facts">
      {
        hero.facts.map((f) => (
          <div class="fact">
            <dt class="fact__label">{f.label}</dt>
            <dd class="fact__value display">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    container-type: inline-size;
  }
  .hero__in {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 1.75rem;
    padding-block: 1.25rem 3.5rem;
  }
  .hero__name {
    grid-column: 1 / -1;
    font-size: clamp(4rem, 31cqi, 18rem);
    line-height: 0.84;
    margin-left: -0.05em;
  }
  .hero__line {
    display: block;
    clip-path: inset(-0.1em -0.1em 0 -0.1em);
  }
  .hero__line > span {
    display: block;
  }
  .hero__portrait {
    grid-column: 1 / 3;
    grid-row: 2 / span 2;
  }
  .hero__portrait-slot {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: end start;
    padding: 0.75rem;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, var(--line) 10px 11px),
      color-mix(in srgb, var(--ink) 6%, transparent);
    border: 1px solid var(--line);
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .hero__pitch {
    grid-column: 3 / -1;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .hero__role {
    font-size: clamp(1.6rem, 7cqi, 3.25rem);
    line-height: 0.9;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .hero__more {
    font-weight: 600;
    font-size: var(--t-s);
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }
  .hero__facts {
    grid-column: 1 / -1;
    display: grid;
    border-top: 1.5px solid var(--ink);
  }
  .fact {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .fact__value {
    order: -1;
    font-size: 2rem;
    text-transform: none;
  }
  .fact__label {
    font-size: var(--t-s);
    color: var(--muted);
  }

  /* Phones: the role sits beside the portrait; the lede and actions run under both. */
  @media (max-width: 899px) {
    .hero__pitch {
      display: contents;
    }
    .hero__role {
      grid-column: 3 / -1;
      grid-row: 2;
      align-self: end;
    }
    .hero__lede,
    .hero__actions {
      grid-column: 1 / -1;
    }
    .hero__portrait {
      grid-row: 2;
    }
  }

  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      min-height: calc(100svh - 4rem);
      align-content: space-between;
      padding-block: clamp(1rem, 3vh, 2rem) clamp(1.5rem, 4vh, 2.5rem);
    }
    .hero__name {
      grid-column: 1 / 9;
      grid-row: 1;
      font-size: min(23cqi, 30svh);
    }
    .hero__portrait {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: start;
    }
    .hero__portrait-slot {
      max-height: 50svh;
      margin-left: auto;
    }
    .hero__pitch {
      grid-column: 1 / 7;
      grid-row: 2;
      align-self: end;
    }
    .hero__lede {
      max-width: 36rem;
      font-size: 1.25rem;
      line-height: 1.45;
    }
    .hero__facts {
      grid-column: 8 / -1;
      grid-row: 2;
      align-self: end;
    }
  }

  @keyframes rise {
    from {
      translate: 0 100%;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  :global(html.motion) .hero__line > span {
    animation: rise var(--d-l) var(--ease) both;
  }
  :global(html.motion) .hero__line + .hero__line > span {
    animation-delay: 80ms;
  }
  :global(html.motion) .hero__portrait,
  :global(html.motion) .hero__pitch,
  :global(html.motion) .hero__facts {
    animation: fade var(--d-m) var(--ease) both;
  }
  :global(html.motion) .hero__portrait {
    animation-delay: 120ms;
  }
  :global(html.motion) .hero__pitch {
    animation-delay: 180ms;
  }
  :global(html.motion) .hero__facts {
    animation-delay: 240ms;
  }
</style>
