---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  /** The share card (public/og/, made by art/og.mjs), and what it shows. */
  image?: string;
  imageAlt?: string;
  /** 'article' for a case study; it also gets its own structured data. */
  type?: 'website' | 'article';
  /** Keep the page out of search (the 404). */
  noindex?: boolean;
  /** How the page closes: the Let's talk invitation (default) or the email running as a headline. */
  close?: 'talk' | 'mail';
}
const {
  title,
  description = site.description,
  image = '/og/home.jpg',
  imageAlt = `${site.name}, ${site.role.toLowerCase()}.`,
  type = 'website',
  noindex = false,
  close = 'talk',
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
// Structured data: who I am on every page, the site on the home page, the work on a case study.
const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.fullName,
  alternateName: site.name,
  jobTitle: site.role,
  url: site.url,
  image: new URL('/og/about.jpg', site.url).href,
  email: `mailto:${site.email}`,
  worksFor: { '@type': 'Organization', name: 'Arthur' },
  knowsAbout: ['Full-stack development', 'TypeScript', 'React', 'Node.js', 'Elixir', 'Go', 'AI agents', 'MCP', 'Real-time systems', 'Product engineering'],
  sameAs: site.socials.map((s) => s.href),
};
const graph: Record<string, unknown>[] = [person];
if (Astro.url.pathname === '/') graph.push({ '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, inLanguage: 'en', publisher: { '@id': person['@id'] } });
if (type === 'article') graph.push({ '@type': 'CreativeWork', name: title, description, url: canonical, image: ogImage, author: { '@id': person['@id'] }, inLanguage: 'en' });
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0b" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.fullName} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/text.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Loader />
    <div data-top aria-hidden="true" style="position:absolute;top:0;left:0;width:1px;height:8px"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer close={close} />
    <script>
      import { start } from '../motion/start';
      start();
    </script>
  </body>
</html>
